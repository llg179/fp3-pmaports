From: Lajoshazi, Laszlo Gergely <lajoshazilg@gmail.com>
Subject: [PATCH] q6voiced: actually start the voice PCM streams

Opening and preparing the VoiceMMode1/CS-Voice PCM is not enough: the ASoC
frontend stays in the "prepare" state, so DPCM never triggers the backends and
the codec (or MI2S amplifier) DAI is never started - the call is silent in both
directions.

Start both streams explicitly. The playback direction needs XRUN detection
disabled first (stop_threshold = boundary), because the voice PCM carries no
data, and the ALSA core refuses to start a playback stream with an empty buffer
(snd_pcm_pre_start() -> !snd_pcm_playback_data() -> -EPIPE).

Verified on the Fairphone 3 (msm8953, WCD9335 over SLIMbus) with live calls:
earpiece + handset mic, headset + headset mic, and speakerphone (Quinary MI2S)
all carry audio in both directions; without the start the downlink is silent on
every routing.

Assisted-by: Claude:claude-opus-5
---
--- a/q6voiced.c
+++ b/q6voiced.c
@@ -10,6 +10,46 @@
 	snd_pcm_t *tx, *rx;
 };
 
+/*
+ * The voice PCM carries no data (the DSP feeds the ports directly), so the
+ * playback ring buffer always stays empty and the ALSA core refuses
+ * snd_pcm_start() with -EPIPE: snd_pcm_pre_start() rejects a playback stream
+ * without data unless XRUN detection is off (stop_threshold >= boundary).
+ *
+ * Without that start the frontend never leaves the "prepare" state, so the DPCM
+ * backends are never triggered - the codec/backend DAI stays idle and the call
+ * is silent. Preparing alone is not enough for either direction.
+ */
+static int q6voiced_start(snd_pcm_t *pcm, bool playback)
+{
+	snd_pcm_sw_params_t *sw;
+	snd_pcm_uframes_t boundary;
+	int ret;
+
+	if (playback) {
+		snd_pcm_sw_params_alloca(&sw);
+
+		ret = snd_pcm_sw_params_current(pcm, sw);
+		if (ret < 0)
+			return ret;
+		ret = snd_pcm_sw_params_get_boundary(sw, &boundary);
+		if (ret < 0)
+			return ret;
+		ret = snd_pcm_sw_params_set_stop_threshold(pcm, sw, boundary);
+		if (ret < 0)
+			return ret;
+		ret = snd_pcm_sw_params(pcm, sw);
+		if (ret < 0)
+			return ret;
+	}
+
+	ret = snd_pcm_prepare(pcm);
+	if (ret < 0)
+		return ret;
+
+	return snd_pcm_start(pcm);
+}
+
 static void q6voiced_open(struct q6voiced *v)
 {
 	if (v->tx)
@@ -21,13 +61,13 @@
 	 */
 	if (snd_pcm_open(&v->tx, v->card, SND_PCM_STREAM_CAPTURE, SND_PCM_NONBLOCK) < 0 ||
 	    snd_pcm_set_params(v->tx, SND_PCM_FORMAT_S16_LE, SND_PCM_ACCESS_RW_INTERLEAVED, 1, 8000, 0, 500000) < 0 ||
-	    snd_pcm_prepare(v->tx) < 0) {
+	    q6voiced_start(v->tx, false) < 0) {
 		perror("Failed to open tx");
 		goto error;
 	}
 	if (snd_pcm_open(&v->rx, v->card, SND_PCM_STREAM_PLAYBACK, SND_PCM_NONBLOCK) < 0 ||
 	    snd_pcm_set_params(v->rx, SND_PCM_FORMAT_S16_LE, SND_PCM_ACCESS_RW_INTERLEAVED, 1, 8000, 0, 500000) < 0 ||
-	    snd_pcm_prepare(v->rx) < 0) {
+	    q6voiced_start(v->rx, true) < 0) {
 		perror("Failed to open rx");
 		goto error;
 	}
