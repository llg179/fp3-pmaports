#!/usr/bin/env python3
"""fp3-voiced - call audio for the Fairphone 3 on mainline postmarketOS.

Does the two things a call needs on this device, in the right order:

  1. applies the ALSA UCM "Voice Call" verb (the codec + q6voice routing), and
  2. opens *and starts* the VoiceMMode1 PCM (hw:0,4) so the ADSP instantiates
     the voice topology.

Both halves have a catch that cost real debugging time:

  * without the verb the PCM cannot even be opened - the frontend has no
    backend and snd_pcm_open() returns -EINVAL ("no backend DAIs enabled"),
    which is exactly how upstream q6voiced fails here; and
  * the playback leg carries no data, so the ALSA core refuses to start it
    with -EPIPE unless XRUN detection is off (stop_threshold = boundary).
    Without that start the DPCM backends are never triggered and the downlink
    stays silent while the uplink works.

It replaces q6voiced on this device (which does 2 but not 1, and does not
start the streams), and it does not rely on callaudiod: callaudiod refuses
the card entirely ("card has no usable source"), because pulseaudio cannot
wrap PCM device 1 of this card as a UCM source.

Call state comes from ModemManager over D-Bus.
"""
import ctypes
import fcntl
import glob
import threading
import os
import pwd
import select
import struct
import subprocess
import sys
import time

CARD = "Fairphone_3"
PCM = "hw:0,4"
POLL = 0.25

# ModemManager call states that mean "audio should be up"
ACTIVE_STATES = {"dialing", "ringing-out", "active"}

a = ctypes.CDLL("libasound.so.2")
a.snd_strerror.restype = ctypes.c_char_p
PLAYBACK, CAPTURE = 0, 1
S16_LE, RW_INTERLEAVED = 2, 3


def log(msg):
    print(msg, flush=True)


def ucm(*args):
    cmd = ["alsaucm", "-c", CARD] + list(args)
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        log("ucm %s failed: %s" % (" ".join(args), r.stderr.strip()))
    return r.returncode == 0


CALLAUDIO = ("org.mobian_project.CallAudio", "/org/mobian_project/CallAudio")

# Set by the button watcher so a speakerphone press is acted on at once.
WAKE = threading.Event()


def session_uid():
    for d in sorted(glob.glob("/run/user/*")):
        if os.path.exists(os.path.join(d, "bus")):
            return int(os.path.basename(d))
    return 0





DPCM_STATE = "/sys/kernel/debug/asoc/Fairphone 3/VoiceMMode1/state"
WATCH_MIXERS = [
    "SLIMBUS_0_RX Voice Mixer VoiceMMode1",
    "QUIN_MI2S_RX Voice Mixer VoiceMMode1",
    "VoiceMMode1 Capture Mixer SLIMBUS_0_TX",
    "SLIM RX0 MUX", "RX INT0_2 MUX", "ADC MUX0", "DMIC MUX0",
    "RX0 Mix Digital Volume", "EAR PA Volume",
]


def _pulse_env_for(d):
    env = dict(os.environ)
    env["PULSE_SERVER"] = "unix:" + os.path.join(d, "pulse", "native")
    env["XDG_RUNTIME_DIR"] = d
    # ...and its cookie, or pulseaudio refuses the connection
    try:
        home = pwd.getpwuid(os.stat(d).st_uid).pw_dir
        cookie = os.path.join(home, ".config", "pulse", "cookie")
        if os.path.exists(cookie):
            env["PULSE_COOKIE"] = cookie
    except (KeyError, OSError):
        pass
    return env


_pulse_dir = []


def pulse_env():
    """Environment that lets this (root) daemon talk to the pulseaudio that
    actually owns the sound card.

    The service runs as root, so pactl would look for a per-root pulseaudio and
    find nothing. Picking the first /run/user/* with a socket is not enough
    either: while the screen is locked the *greeter* runs its own pulseaudio,
    and talking to that one means reading the wrong card state (or none). Ask
    each candidate whether it has our card, and remember the one that does.
    """
    if _pulse_dir and time.time() - _pulse_dir[1] < 5:
        return _pulse_env_for(_pulse_dir[0])       # good a moment ago
    dirs = sorted(glob.glob("/run/user/*"))
    if _pulse_dir and _pulse_dir[0] in dirs:
        dirs = [_pulse_dir[0]] + [d for d in dirs if d != _pulse_dir[0]]
    for d in dirs:
        env = _pulse_env_for(d)
        try:
            out = subprocess.run(["pactl", "list", "short", "cards"],
                                 capture_output=True, text=True, env=env).stdout
        except OSError:
            continue
        if "sound-card" in out:
            _pulse_dir[:] = [d, time.time()]
            return env
    return _pulse_env_for(dirs[0]) if dirs else dict(os.environ)


def pactl(*args):
    try:
        return subprocess.run(["pactl"] + list(args), capture_output=True,
                              text=True, env=pulse_env()).stdout
    except FileNotFoundError:
        return ""


# What the volume slider is called while the call owns the card. Setting the
# card profile to "off" leaves pulseaudio with no sink of its own, so
# module-always-sink inserts its own - and every volume popup on the phone then
# reads "Dummy Output", whichever output the call is really using.
#
# Renaming that sink is not an option from here: only pacmd can rewrite a
# proplist, and pacmd talks to pulseaudio's CLI socket inside the user's
# runtime directory rather than over the protocol, so it refuses this (root)
# daemon outright - "No PulseAudio daemon running, or not running as session
# daemon", with PULSE_SERVER and PULSE_RUNTIME_PATH both pointing at the right
# place. So instead of renaming always-sink's null sink, get in first with one
# of our own, carrying the description we want. module-always-sink only steps
# in when the card has no sink at all, so ours simply pre-empts it.
_call_sink = []


def pa_call_sink(output):
    """Give the call a sink named after the output it is really using."""
    pa_drop_call_sink()
    r = subprocess.run(
        ["pactl", "load-module", "module-null-sink",
         "sink_name=fp3_call",
         "sink_properties=device.description='%s'" % output],
        capture_output=True, text=True, env=pulse_env())
    if r.returncode:
        log("call sink: load-module failed: %s" % r.stderr.strip()[:120])
        return
    _call_sink[:] = [r.stdout.strip()]
    pactl("set-default-sink", "fp3_call")


def pa_drop_call_sink():
    if not _call_sink:
        return
    pactl("unload-module", _call_sink[0])
    _call_sink[:] = []


def pa_card():
    for line in pactl("list", "short", "cards").splitlines():
        f = line.split()
        if len(f) > 1 and "sound-card" in f[1]:
            return f[1]
    return None



def pa_set_profile(card, profile):
    if not (card and profile):
        return False
    r = subprocess.run(["pactl", "set-card-profile", card, profile],
                       capture_output=True, text=True, env=pulse_env())
    if r.returncode:
        log("pactl set-card-profile %s failed: %s" % (profile, r.stderr.strip()))
        return False
    return True


def pa_active_profile():
    for line in pactl("list", "cards").splitlines():
        if "Active Profile:" in line:
            return line.split(":", 1)[1].strip()
    return None


_saved_profile = []
_pending_output = []       # where the call is about to go, for the sink name


def pa_release_card():
    """Hand the whole card back to us for the duration of the call.

    Suspending the streams is not enough: a suspended sink is resumed by any
    client that wants to play, and by pulseaudio itself when the mixer changes
    underneath it. When that happened while the call was being set up, its
    media stream tried to start SLIMBUS_0_RX a second time, got ADSP_EALREADY,
    and pulseaudio dropped the sink for good - the port stays started inside the
    DSP, so every later open fails with -22 and the phone has no media audio and
    no ringtone until it is rebooted. Setting the card profile to "off" makes
    pulseaudio close the backend and keep away from it.

    The volume keys keep working: with the card off they act on pulseaudio's
    fallback sink, and the percentage is what we mirror onto the codec gain.
    """
    card = pa_card()
    if not card:
        return
    prof = pa_active_profile()
    # Never remember a Voice Call profile: pulseaudio sometimes sits on one
    # already (they are offered per output and it picks by availability), and
    # restoring it after the call opens its sink straight back onto
    # SLIMBUS_0_RX - which is exactly the ADSP_EALREADY wedge this avoids.
    if prof and prof != "off" and not prof.startswith("Voice Call"):
        _saved_profile[:] = [prof]
    pa_call_sink(_pending_output[0] if _pending_output else "Call")
    pa_set_profile(card, "off")
    for _ in range(20):
        if not [l for l in pactl("list", "short", "sinks").splitlines()
                if l.split() and "auto_null" not in l]:
            time.sleep(0.3)          # let the backend finish tearing down
            return
        time.sleep(0.1)
    log("warning: the card still has sinks after 2s")


def pa_hifi_profiles():
    """The HiFi profiles pulseaudio currently considers available, best first.

    Restoring a profile pulseaudio thinks is unavailable is worse than doing
    nothing: it drops the card to "off" and the phone is left with no sink.
    """
    out = []
    for line in pactl("list", "cards").splitlines():
        line = line.strip()
        if line.startswith("HiFi (") and "available: yes" in line:
            name = line.split(":", 1)[0].strip()
            prio = 0
            if "priority: " in line:
                try:
                    prio = int(line.split("priority: ", 1)[1].split(",")[0])
                except ValueError:
                    pass
            out.append((prio, name))
    return [n for _, n in sorted(out, reverse=True)]


def pa_restore_card():
    """Give the card back, but only once the voice path has really let go.

    Handing it back in the same instant the call is torn down puts
    pulseaudio's sink on SLIMBUS_0_RX while the DSP still has the port
    started, so it gets ADSP_EALREADY and the sink is lost until reboot.
    Wait for the port to settle, then check that a real sink actually
    appeared and try once more if it did not.
    """
    card = pa_card()
    if not card:
        return
    pa_drop_call_sink()
    available = pa_hifi_profiles()
    fallback = available[0] if available else "HiFi (Speaker)"
    prof = (_saved_profile[0] if _saved_profile and _saved_profile[0] in available
            else fallback)
    time.sleep(1.5)                  # let the voice AFE port stop in the DSP
    for attempt in (1, 2):
        if not pa_set_profile(card, prof):
            pa_set_profile(card, fallback)
            prof = fallback
        for _ in range(15):
            if [l for l in pactl("list", "short", "sinks").splitlines()
                    if l.split() and "auto_null" not in l]:
                log("pulseaudio card restored to %s" % prof)
                return
            time.sleep(0.2)
        log("no sink after restoring %s (attempt %d)" % (prof, attempt))
        pa_set_profile(card, "off")
        time.sleep(2)
    log("warning: pulseaudio has no sink on the card")


def pa_streams(suspend):
    """Stop pulseaudio streaming on the card while the call owns the backend.

    The call and pulseaudio's media stream would otherwise share SLIMBUS_0_RX
    (and the standalone microphone source SLIMBUS_0_TX): whoever starts the AFE
    port first configures it, the other one gets ADSP_EALREADY, and the call is
    silent in both directions even though every route looks right.

    This runs on top of pa_release_card(): the profile switch is what actually
    keeps pulseaudio off the backend, this only leaves nothing streaming behind.
    """
    arg = "1" if suspend else "0"
    for line in pactl("list", "short", "sinks").splitlines():
        f = line.split()
        if len(f) > 1 and "auto_null" not in f[1]:
            pactl("suspend-sink", f[1], arg)
    for line in pactl("list", "short", "sources").splitlines():
        f = line.split()
        if len(f) > 1 and "monitor" not in f[1]:
            pactl("suspend-source", f[1], arg)
    if not suspend:
        return
    # Wait for the PCMs to actually close. Opening the voice path while
    # pulseaudio still has the backend open means the AFE port was configured
    # by its media stream first; ours then gets ADSP_EALREADY and the downlink
    # stays silent - the failure is timing dependent, which is why the same
    # routing sometimes worked and sometimes did not.
    for _ in range(20):
        busy = [l for l in pactl("list", "short", "sinks").splitlines()
                if l.split() and "auto_null" not in l and "SUSPENDED" not in l]
        if not busy:
            time.sleep(0.3)      # let the backend finish tearing down
            return
        time.sleep(0.1)
    log("warning: pulseaudio streams still running after 2s")


def snapshot(tag):
    """One line per interesting control - the ground truth for a silent call."""
    try:
        with open(DPCM_STATE) as fh:
            state = [l.strip() for l in fh if l.strip().startswith(("[", "State:", "- "))]
        log("%s dpcm: %s" % (tag, " | ".join(state)))
    except OSError as e:
        log("%s dpcm: unreadable (%s)" % (tag, e))
    # One process per control. The batch form ("amixer -c0 -s" with a script on
    # stdin) looked cheaper and was used here, but it only executes cset - a
    # cget in a script prints nothing at all and exits 0, so every value in this
    # line read back as "?" and the snapshot carried no information whatsoever.
    vals = []
    for c in WATCH_MIXERS:
        short = c.split()[0] + "/" + c.split()[-1]
        try:
            out = subprocess.run(["amixer", "-c", "0", "cget", "name=" + c],
                                 capture_output=True, text=True).stdout
        except OSError:
            return
        got = [l.split("=", 1)[1] for l in out.splitlines() if ": values" in l]
        vals.append("%s=%s" % (short, got[0] if got else "?"))
    log("%s mixers: %s" % (tag, " ".join(vals)))


def open_leg(stream, label, playback):
    h = ctypes.c_void_p()
    rc = a.snd_pcm_open(ctypes.byref(h), PCM.encode(), stream, 0)
    if rc < 0:
        log("%s: open failed: %s" % (label, a.snd_strerror(rc).decode()))
        return None
    rc = a.snd_pcm_set_params(h, S16_LE, RW_INTERLEAVED, ctypes.c_uint(1),
                              ctypes.c_uint(8000), ctypes.c_int(1),
                              ctypes.c_uint(500000))
    if rc == -22:
        # -EINVAL here means the frontend ended up with two backends; the leg is
        # unusable, so say so and let the caller rebuild rather than carrying a
        # half-open stream that reports "up" but is silent.
        log("%s: set_params failed: %s" % (label, a.snd_strerror(rc).decode()))
        a.snd_pcm_close(h)
        return None
    if rc < 0:
        log("%s: set_params failed: %s" % (label, a.snd_strerror(rc).decode()))

    if playback:
        # Disable XRUN detection so an empty playback buffer can still start.
        sw = ctypes.create_string_buffer(a.snd_pcm_sw_params_sizeof())
        p = ctypes.cast(sw, ctypes.c_void_p)
        boundary = ctypes.c_ulong(0)
        a.snd_pcm_sw_params_current(h, p)
        a.snd_pcm_sw_params_get_boundary(p, ctypes.byref(boundary))
        a.snd_pcm_sw_params_set_stop_threshold(h, p, ctypes.c_ulong(boundary.value))
        a.snd_pcm_sw_params_set_start_threshold(h, p, ctypes.c_ulong(1))
        a.snd_pcm_sw_params(h, p)

    a.snd_pcm_prepare(h)
    rc = a.snd_pcm_start(h)
    if rc < 0:
        log("%s: start failed: %s" % (label, a.snd_strerror(rc).decode()))
    return h


# "RXn Mix Digital Volume" is 0..124 in 1 dB steps with 84 == 0 dB. Mapping the
# whole range put every setting between 0 and +40 dB, where the far end is
# already loud and clipping, so the keys felt dead. Use a range you can actually
# hear across: -24 dB at the bottom, +26 dB at the top.
EAR_VOL_MAX = 110
EAR_VOL_MIN = 60
# Headphones sit far closer to the ear than the earpiece does, and the same
# +26 dB there is painful - full volume on a headset was "nearly deafening".
# Keep the top at +6 dB and the bottom lower, so the usable range is on the
# quiet side of the earpiece one.
HPH_VOL_MAX = 90
HPH_VOL_MIN = 45
# aw8898 "RX Volume": 0..255 in 0.5 dB steps, 255 == 0 dB
SPK_VOL_MAX = 255
SPK_VOL_MIN = 160

# Each output keeps its own level, like every phone does: the volume you set on
# speakerphone must not carry over to a headset the moment you plug it in.
_out_volume = {}


def pa_sink_volume_pct():
    """Whatever the volume keys last set on pulseaudio's sink."""
    out = pactl("get-sink-volume", "@DEFAULT_SINK@")
    for tok in out.replace("/", " ").split():
        if tok.endswith("%"):
            try:
                return int(tok[:-1])
            except ValueError:
                pass
    return None


def _cset(name, value):
    subprocess.run(["amixer", "-c", "0", "cset", "name=" + name, str(value)],
                   capture_output=True)


def mirror_volume(output, pct):
    """Apply pulseaudio's sink volume to the gain that carries the current output.

    Handing pulseaudio the Voice Call profile would do this by itself, but that
    also puts its media sink on the same SLIMbus backend as the call, which
    reconfigures the codec's slim stream and leaves the earpiece silent. So keep
    pulseaudio off the backend and mirror the volume instead - and mirror it
    onto the control that is really in the path, so that turning the volume down
    on speakerphone does not just quieten an earpiece nobody is holding.
    """
    if pct is None:
        return
    pct = max(0, min(100, pct))
    _out_volume[output] = pct
    if output == "Speaker":
        val = SPK_VOL_MIN + (SPK_VOL_MAX - SPK_VOL_MIN) * pct // 100
        _cset("RX Volume", val)                      # the aw8898 amplifier
        log("volume %d%% -> speaker RX Volume %d" % (pct, val))
        return
    if output == "Headphones":
        val = HPH_VOL_MIN + (HPH_VOL_MAX - HPH_VOL_MIN) * pct // 100
        _cset("RX1 Mix Digital Volume", val)
        _cset("RX2 Mix Digital Volume", val)
    else:
        val = EAR_VOL_MIN + (EAR_VOL_MAX - EAR_VOL_MIN) * pct // 100
        _cset("RX0 Mix Digital Volume", val)
    log("volume %d%% -> %s %d" % (pct, output, val))


_last_pct = [None]        # what the volume keys last produced, cached


def restore_output_volume(output):
    """Put this output's own level back when the call moves to it.

    Without this the percentage the volume keys last produced follows the call
    from one output to the next, and plugging a headset in while the speaker
    was loud is painful.

    The codec gain is applied straight away - a re-route must not wait on a
    pactl round trip - and pulseaudio's own slider is corrected right after,
    off the critical path.
    """
    pct = _out_volume.get(output, _last_pct[0])
    mirror_volume(output, pct)
    if pct is not None and _last_pct[0] != pct:
        threading.Thread(
            target=lambda: pactl("set-sink-volume", "@DEFAULT_SINK@",
                                 "%d%%" % pct),
            daemon=True).start()
        _last_pct[0] = pct
    return pct

# evdev bits we need from <linux/input.h>: the jack is an input device that
# reports switches, so it can be *read* instead of polled. Polling it cost two
# amixer processes every tick, which is most of what this daemon used to burn.
EV_SW = 0x05
SW_HEADPHONE_INSERT = 0x02
SW_MICROPHONE_INSERT = 0x04
EVIOCGSW = 0x8008451b          # EVIOCGSW(len=8)
_EVENT_FMT = "llHHi"           # timeval + type + code + value (64-bit)
_EVENT_SIZE = struct.calcsize(_EVENT_FMT)


class JackWatch(threading.Thread):
    """Track the headset switch by reading the codec's input device.

    The codec reports a headset (with a microphone) and plain headphones on
    two different switches of the same device; only the state matters here,
    and reading it costs nothing until something actually moves.
    """

    def __init__(self):
        threading.Thread.__init__(self, daemon=True)
        self.plugged = False
        self.has_mic = False
        self.fd = None

    def _open(self):
        for path in sorted(glob.glob("/dev/input/event*")):
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            name = bytearray(64)
            try:
                fcntl.ioctl(fd, 0x82004506, name)      # EVIOCGNAME(64)
            except OSError:
                os.close(fd)
                continue
            if b"Headset Jack" not in bytes(name):
                os.close(fd)
                continue
            self.fd = fd
            self._read_state()
            log("jack: watching %s (plugged=%s mic=%s)"
                % (path, self.plugged, self.has_mic))
            return True
        return False

    def _read_state(self):
        buf = bytearray(8)
        try:
            fcntl.ioctl(self.fd, EVIOCGSW, buf)
        except OSError:
            return
        bits = int.from_bytes(buf, "little")
        self.has_mic = bool(bits & (1 << SW_MICROPHONE_INSERT))
        self.plugged = bool(bits & (1 << SW_HEADPHONE_INSERT)) or self.has_mic

    def run(self):
        while True:
            if self.fd is None and not self._open():
                time.sleep(5)                 # no jack device yet
                continue
            try:
                r, _, _ = select.select([self.fd], [], [], 30)
                if not r:
                    continue
                data = os.read(self.fd, _EVENT_SIZE * 32)
            except OSError as e:
                log("jack: read failed (%s), reopening" % e)
                try:
                    os.close(self.fd)
                except OSError:
                    pass
                self.fd = None
                continue
            changed = False
            for off in range(0, len(data) - _EVENT_SIZE + 1, _EVENT_SIZE):
                _, _, etype, code, _ = struct.unpack_from(_EVENT_FMT, data, off)
                if etype == EV_SW and code in (SW_HEADPHONE_INSERT,
                                               SW_MICROPHONE_INSERT):
                    changed = True
            if changed:
                was = (self.plugged, self.has_mic)
                self._read_state()
                now = (self.plugged, self.has_mic)
                if now != was:
                    log("jack: plugged=%s mic=%s (was plugged=%s mic=%s)"
                        % (now[0], now[1], was[0], was[1]))
                WAKE.set()

    def resync(self):
        """Re-read the switch straight from the driver.

        The cached state is only as good as the last edge that arrived, and the
        codec re-arms its mechanical detection on every one of them - a path
        teardown can therefore leave the cache claiming "unplugged" with a
        headset still in the socket. Anything that decides where a call is
        going asks the hardware instead.
        """
        if self.fd is None:
            return
        was = (self.plugged, self.has_mic)
        self._read_state()
        now = (self.plugged, self.has_mic)
        if now != was:
            log("jack: resync corrected plugged=%s mic=%s (cache said %s/%s)"
                % (now[0], now[1], was[0], was[1]))


class LineWatch(threading.Thread):
    """Run a command that prints one line per event and wake the loop.

    Both things this daemon has to notice - a call appearing and the volume
    keys moving - are published as events, so polling for them meant spawning
    an mmcli and a pactl every quarter second for the whole uptime of the
    phone. Watch the event streams instead and only ask when something moved.
    """

    def __init__(self, argv, env_fn=None, flag=None, name="watch"):
        threading.Thread.__init__(self, daemon=True)
        self.argv = argv
        self.env_fn = env_fn
        self.flag = flag if flag is not None else []
        self.wname = name

    def run(self):
        while True:
            try:
                p = subprocess.Popen(self.argv, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, text=True,
                                     env=(self.env_fn() if self.env_fn
                                          else dict(os.environ)))
            except OSError as e:
                log("%s: cannot start (%s)" % (self.wname, e))
                time.sleep(30)
                continue
            for _line in p.stdout:
                self.flag[:] = [True]
                WAKE.set()
            time.sleep(2)                     # it died - restart it


_jack_watch = JackWatch()
_call_event = []
_pa_event = []


def jack_state():
    """(something plugged, it has a microphone)."""
    return _jack_watch.plugged, _jack_watch.has_mic


def jack_plugged():
    return _jack_watch.plugged


_buttons_ref = []


def wanted_output(speaker, plugged):
    if speaker:
        return "Speaker"
    return "Headphones" if plugged else "Earpiece"


class ButtonWatch:
    """Watch the in-call buttons on the session bus.

    SpeakerState can be polled (callaudiod keeps it even though it cannot apply
    it here), but MicState is never updated on this device - callaudiod bails
    out before it gets that far. So watch the method calls themselves: that is
    what the app sends either way.
    """

    def __init__(self):
        self.mute = None
        self.muted = False        # last requested state, re-applied after a switch
        self.speaker = None
        self.proc = None

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def start(self):
        uid = session_uid()
        if not uid:
            return              # no user session yet - main() retries
        try:
            gid = pwd.getpwuid(uid).pw_gid
        except KeyError:
            return

        def drop():
            os.setgid(gid)
            os.setuid(uid)

        env = dict(os.environ)
        env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=/run/user/%d/bus" % uid
        env["XDG_RUNTIME_DIR"] = "/run/user/%d" % uid
        try:
            self.proc = subprocess.Popen(
                ["dbus-monitor", "--session",
                 "destination='%s'" % CALLAUDIO[0]],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                env=env, preexec_fn=drop)
        except OSError as e:
            log("button watch unavailable: %s" % e)
            return
        log("watching the in-call buttons")
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        member = None
        for line in self.proc.stdout:
            line = line.strip()
            if "member=" in line:
                member = line.rsplit("member=", 1)[1].strip()
            elif line.startswith("boolean") and member:
                val = line.endswith("true")
                if member == "MuteMic":
                    self.muted = val
                    set_mic_muted(val)          # instant, not on the next poll
                elif member == "EnableSpeaker":
                    self.speaker = val
                    WAKE.set()                  # do not wait out the poll
                member = None


# "DEC0 Volume" is the S8 decimator gain, and like the RX gains amixer takes it
# raw: 0 is -84 dB (silence) and 84 is 0 dB. Passing "-84" would not even reach
# the control - amixer parses a leading dash as an option.
MIC_GAIN_ON = 84
MIC_GAIN_MUTE = 0


def set_mic_muted(muted):
    """Mute the uplink with the decimator gain, never by re-routing.

    Muting used to switch "AIF1_CAP Mixer SLIM TX0" off. That does silence
    the uplink, but it takes the microphone out of the DAPM graph, and this
    codec does not bring the capture path back when it is routed in again:
    measured on the media capture, the level goes to exactly zero and stays
    there for the rest of the boot, through a fresh PCM open and a full
    re-apply of the routing. So the unmute did nothing, and the microphone
    stayed dead for every later call as well.

    "DEC0 Volume" is the decimator's digital gain, which does not touch the
    graph at all: -84 dB is silence, and going back to 0 dB restores the
    level immediately.
    """
    subprocess.run(["amixer", "-c", "0", "cset", "name=DEC0 Volume",
                    str(MIC_GAIN_MUTE if muted else MIC_GAIN_ON)],
                   capture_output=True)
    log("microphone %s" % ("muted" if muted else "unmuted"))


class Session:
    def __init__(self):
        self.pcm = []
        self.output = None
        self.forced_output = None
        self.snapshot_due = 0

    def up(self):
        return bool(self.pcm)

    def start(self, retry=False, pa_ready=False):
        # a plugged headset wins over whatever pulseaudio was routed to
        _jack_watch.resync()          # ask the driver, not the cache
        plugged, has_mic = jack_state()
        self.output = self.forced_output or wanted_output(False, plugged)
        mic = "Headset" if has_mic else "Mic"   # follows the jack, not the output
        log("routing: jack plugged=%s mic=%s forced=%s -> %s + %s"
            % (plugged, has_mic, self.forced_output or "-", self.output, mic))
        _pending_output[:] = [self.output]
        # Order matters. Whoever starts the AFE port configures it, and a second
        # start only answers ADSP_EALREADY - so the voice path has to get there
        # first. Switching the pulseaudio profile opens its media sink on the
        # same backend, so: quiet pulseaudio, apply the routing ourselves, open
        # the call, and only then hand the profile over for the volume keys.
        if not (retry or pa_ready):
            # Only on the first build of a call: pulseaudio already let go of
            # the card, and asking it again costs about a second per re-route.
            pa_streams(True)
            pa_release_card()
        if not ucm("set", "_verb", "Voice Call", "set", "_enadev", self.output,
                   "set", "_enadev", mic):
            pa_restore_card()
            pa_streams(False)
            return
        restore_output_volume(self.output)     # before the sound appears
        for stream, label, pb in ((PLAYBACK, "downlink", True),
                                  (CAPTURE, "uplink", False)):
            h = open_leg(stream, label, pb)
            if h:
                self.pcm.append(h)
        if len(self.pcm) < 2 and not retry:
            # A leg that would not open means the frontend picked up a stale
            # backend. Drop everything and build the session once more instead
            # of leaving the call half connected.
            log("only %d of 2 legs opened, rebuilding" % len(self.pcm))
            for h in self.pcm:
                a.snd_pcm_close(h)
            self.pcm = []
            ucm("set", "_verb", "HiFi")
            time.sleep(1.0)
            self.start(retry=True, pa_ready=True)
            return
        log("call audio up (%s + %s)" % (self.output, mic))
        if _call_sink:
            pa_call_sink(self.output)      # a re-route renames the slider too

        if _buttons_ref and _buttons_ref[0].muted:
            set_mic_muted(True)          # a re-route re-enabled the muted mixer
        self.snapshot_due = time.time() + 1.0

    def switch_output(self, output):
        """Move an in-call stream to another output.

        Two reasons this is a full stop-and-start rather than a re-route:

        * the ADSP builds the CVP with the RX port it was given when the session
          was created, so flipping the UCM device alone moves the codec routing
          but not the voice stream; and
        * reopening the frontend while the old device is still enabled leaves
          *both* backends attached to it (seen in the DPCM state as "Quinary
          MI2S" and "SLIM Playback" at once), after which the SLIMbus
          transactions time out and neither direction carries audio.

        So tear the whole session down - including dropping every device by
        going back to the HiFi verb - let it settle, then bring it up again.
        """
        log("output switch -> %s" % output)
        for h in self.pcm:
            a.snd_pcm_close(h)
        self.pcm = []
        # No "_disdev" here: each alsaucm run is a fresh process that knows
        # nothing about the device enabled before, so the call always failed.
        # Each Voice Call device now drops the other outputs' routes in its own
        # EnableSequence instead, which is what keeps the frontend from picking
        # up two backends ("Quinary MI2S" and "SLIM Playback" at once).
        ucm("set", "_verb", "HiFi")          # drops the call devices and their BEs
        time.sleep(0.15)                     # let the old backend leave the graph
        self.forced_output = output
        self.start(pa_ready=True)

    def stop(self):
        snapshot("down")
        set_mic_muted(False)
        for h in self.pcm:
            a.snd_pcm_close(h)
        self.pcm = []
        self.forced_output = None
        ucm("set", "_verb", "HiFi")
        pa_restore_card()
        pa_streams(False)
        log("call audio down")


INACTIVE_STATES = {"ringing-in", "waiting", "terminated", "unknown"}
_last_call_log = [""]
_last_state = {}


def calls_active():
    """True while a call is up (dialing, ringing out, or answered).

    Deliberately permissive: anything the modem lists counts unless it is a
    state where audio must not be taken over yet (an incoming call still
    ringing, a waiting call, or one that is already gone). A call the daemon
    fails to notice is silent audio, so err on the side of engaging.
    """
    r = subprocess.run(["mmcli", "-m", "any", "--voice-list-calls"],
                       capture_output=True, text=True)
    out = (r.stdout or "") + (r.stderr or "")
    if r.returncode:
        if out.strip() != _last_call_log[0]:
            _last_call_log[0] = out.strip()
            log("mmcli failed (rc=%d): %s" % (r.returncode, out.strip()[:200]))
        return False
    if "no calls" in out.lower():
        _last_call_log[0] = ""
        return False

    paths = [w for w in out.split() if "/Call/" in w]
    if out.strip() != _last_call_log[0]:
        _last_call_log[0] = out.strip()
        log("calls: %s" % " ".join(paths) if paths else "calls: %s" % out.strip()[:200])

    active = False
    for path in paths:
        idx = path.rsplit("/", 1)[-1]
        c = subprocess.run(["mmcli", "-K", "--call", idx],
                           capture_output=True, text=True)
        state = ""
        for line in c.stdout.splitlines():
            if line.startswith("call.properties.state"):
                state = line.split(":", 1)[1].strip()
                break
        prev = _last_state.get(idx)
        if state != prev:
            _last_state[idx] = state
            log("  call %s state=%s (was %s)" % (idx, state or "?", prev or "-"))
        if state and state not in INACTIVE_STATES:
            active = True
        elif not state:
            # Unreadable state. Erring towards "engage" is right for a call we
            # have never seen, but wrong for one that is going away: mmcli stops
            # answering the instant the call object is dropped, so an incoming
            # call that was rejected or timed out read as active for one tick,
            # and the daemon took the card - which suspends the sink and kills
            # the ringtone that was playing at that moment (measured 22:57:06,
            # four "Failed to create sink input: sink is suspended" in a row).
            # A call last seen in an inactive state is therefore left alone.
            if prev in INACTIVE_STATES:
                continue
            active = True          # never seen it - assume it needs audio
    return active


def startup_reset():
    """Clean slate: nothing but a HiFi profile may be active outside a call.

    Two states are worth undoing here. A crash mid-call leaves the card
    released ("off") and the Voice Call verb applied, which looks like a
    completely silent phone. And pulseaudio remembers the last profile it used
    across reboots, so once it has been on a Voice Call profile it comes back on
    it - which puts its media sink, the ringtone included, on the call's
    SLIMBUS_0_RX backend and wedges the AFE port for the whole boot.

    The card can take a few seconds to appear after boot, so wait for it.
    """
    for _ in range(15):
        if pa_card() and ucm("set", "_verb", "HiFi"):
            break
        time.sleep(1)
    idle_check("startup")
    pa_streams(False)


def idle_check(tag):
    """Put the card back on a HiFi profile if it is not on one.

    This runs at startup and then periodically while no call is up, because the
    state that has to be undone can appear later: the graphical session starts
    at the *greeter*, whose pulseaudio owns the card until the phone is
    unlocked, and the user's own pulseaudio then comes up with whatever profile
    it remembered - including "off" or a Voice Call one, either of which leaves
    the phone with no sink and no ringtone.
    """
    if not pa_card():
        return
    prof = pa_active_profile()
    if prof is None or prof == "off" or prof.startswith("Voice Call"):
        log("%s: card is on %s, putting it back on HiFi" % (tag, prof))
        _saved_profile[:] = []
        pa_restore_card()


def main():
    _jack_watch.start()
    time.sleep(0.3)                  # let it read the initial switch state
    startup_reset()
    LineWatch(["dbus-monitor", "--system",
               "type='signal',sender='org.freedesktop.ModemManager1'"],
              flag=_call_event, name="modem watch").start()
    LineWatch(["pactl", "subscribe"], env_fn=pulse_env,
              flag=_pa_event, name="pulseaudio watch").start()
    log("fp3-voiced: watching ModemManager for calls")
    session = Session()
    buttons = ButtonWatch()
    _buttons_ref.append(buttons)
    buttons.start()
    ticks = 0
    last_jack = jack_plugged()
    jack_settled = 0
    last_volume = None
    last_switch = 0.0
    last_poll = 0.0
    last_idle_check = 0.0
    speaker = False
    wanted = False
    while True:
        now = time.time()
        try:
            wanted, speaker, last_jack, jack_settled, last_volume, \
                last_switch, last_poll, last_idle_check, ticks = _tick(
                    session, buttons, now, wanted, speaker, last_jack,
                    jack_settled, last_volume, last_switch, last_poll,
                    last_idle_check, ticks)
        except Exception as e:
            log("loop error: %s" % e)
        WAKE.wait(POLL if session.up() else 5)
        WAKE.clear()


def _tick(session, buttons, now, wanted, speaker, last_jack, jack_settled,
          last_volume, last_switch, last_poll, last_idle_check, ticks):
    """One pass of the loop. Returns the state the next pass starts from."""
    def state():
        return (wanted, speaker, last_jack, jack_settled, last_volume,
                last_switch, last_poll, last_idle_check, ticks)

    if not buttons.alive():
        buttons.start()
    # ModemManager publishes call state as signals, so ask it only when one
    # arrived. The heartbeat stays short enough to catch a call on its own if
    # the signal path ever breaks - missing a call is worse than one mmcli
    # every three seconds.
    if _call_event or now - last_poll > (2 if session.up() else 3):
        _call_event[:] = []
        last_poll = now
        wanted = calls_active()
    if wanted and not session.up():
        speaker = False
        session.forced_output = None
        session.start()
        ticks = 0
        last_switch = time.time()
    elif not wanted and session.up():
        session.stop()
    elif session.up():
        if buttons.speaker is not None:
            speaker = buttons.speaker
            buttons.speaker = None
        plugged = jack_plugged()
        if plugged != last_jack:
            # Give the codec's headset detection a moment to settle before
            # acting on it: rebuilding the call in the same instant the plug is
            # sensed can pick the built-in microphone even though the headset
            # has one, because the MBHC is still deciding.
            last_jack = plugged
            jack_settled = now + 0.6
        if jack_settled and now < jack_settled and not speaker:
            return state()                    # the button still gets through
        jack_settled = 0
        want = wanted_output(speaker, plugged)
        if want != session.output and now - last_switch > 1:
            session.switch_output(want)
            last_switch = time.time()
            _pa_event[:] = [True]             # re-read the level after a move
        if _pa_event:
            _pa_event[:] = []
            pct = pa_sink_volume_pct()
            if pct != last_volume:
                mirror_volume(session.output, pct)
                last_volume = pct
            _last_pct[0] = pct
        if session.snapshot_due and now >= session.snapshot_due:
            session.snapshot_due = 0
            snapshot("up")
        ticks += 1
        if ticks % 40 == 0:
            snapshot("in call")
    else:
        _pa_event[:] = []
        if now - last_idle_check > 30:
            last_idle_check = now
            idle_check("idle")
    return state()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
