#!/usr/bin/env python3
"""fp3-voiced - call audio for the Fairphone 3 on mainline postmarketOS.

Does the two things a call needs on this device, in the right order:

  1. applies the ALSA UCM "Voice Call" verb (the codec + q6voice routing), and
  2. opens *and starts* the VoiceMMode1 PCM (hw:0,4) so the ADSP instantiates
     the voice topology.

Both halves have a catch that cost real debugging time:

  * without the verb the PCM cannot even be opened - the frontend has no
    backend and snd_pcm_open() returns -EINVAL ("no backend DAIs enabled"),
    which is exactly how upstream q6voiced fails here; and
  * the playback leg carries no data, so the ALSA core refuses to start it
    with -EPIPE unless XRUN detection is off (stop_threshold = boundary).
    Without that start the DPCM backends are never triggered and the downlink
    stays silent while the uplink works.

It replaces q6voiced on this device (which does 2 but not 1, and does not
start the streams), and it does not rely on callaudiod: callaudiod refuses
the card entirely ("card has no usable source"), because pulseaudio cannot
wrap PCM device 1 of this card as a UCM source.

Call state comes from ModemManager over D-Bus.
"""
import ctypes
import glob
import threading
import os
import pwd
import subprocess
import sys
import time

CARD = "Fairphone_3"
PCM = "hw:0,4"
POLL = 0.5

# ModemManager call states that mean "audio should be up"
ACTIVE_STATES = {"dialing", "ringing-out", "active"}

a = ctypes.CDLL("libasound.so.2")
a.snd_strerror.restype = ctypes.c_char_p
PLAYBACK, CAPTURE = 0, 1
S16_LE, RW_INTERLEAVED = 2, 3


def log(msg):
    print(msg, flush=True)


def ucm(*args):
    cmd = ["alsaucm", "-c", CARD] + list(args)
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        log("ucm %s failed: %s" % (" ".join(args), r.stderr.strip()))
    return r.returncode == 0


CALLAUDIO = ("org.mobian_project.CallAudio", "/org/mobian_project/CallAudio")


def session_uid():
    for d in sorted(glob.glob("/run/user/*")):
        if os.path.exists(os.path.join(d, "bus")):
            return int(os.path.basename(d))
    return 0


def session_user():
    try:
        return pwd.getpwuid(session_uid()).pw_name
    except KeyError:
        return None


def session_bus_env():
    env = dict(os.environ)
    for d in sorted(glob.glob("/run/user/*")):
        bus = os.path.join(d, "bus")
        if os.path.exists(bus):
            env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=" + bus
            break
    return env


def as_session_user(argv):
    """Run a command as the session user, without PAM.

    The session bus refuses a connection from root even with the right address,
    so these have to run as the user - but going through su/sudo twice a second
    would push a PAM record into the journal every time.
    """
    uid = session_uid()
    if not uid:
        return ""
    try:
        gid = pwd.getpwuid(uid).pw_gid
    except KeyError:
        return ""

    def drop():
        os.setgid(gid)
        os.setuid(uid)

    env = dict(os.environ)
    env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=/run/user/%d/bus" % uid
    env["XDG_RUNTIME_DIR"] = "/run/user/%d" % uid
    try:
        return subprocess.run(argv, capture_output=True, text=True, env=env,
                              preexec_fn=drop).stdout
    except OSError:
        return ""


def speaker_wanted():
    """callaudiod's SpeakerState - i.e. the app's speakerphone button.

    callaudiod cannot apply it on this device (it rejects the card for having
    no usable source) but it does track the state, so it still tells us what
    the user pressed.
    """
    out = as_session_user(["busctl", "--user", "get-property", CALLAUDIO[0],
                           CALLAUDIO[1], CALLAUDIO[0], "SpeakerState"])
    return out.strip().endswith("1")


def active_output():
    """Earpiece unless pulseaudio is currently on the speaker or headphones."""
    try:
        out = subprocess.run(["pactl", "list", "sinks"], capture_output=True,
                             text=True).stdout
    except FileNotFoundError:
        return "Earpiece"
    for line in out.splitlines():
        if "Active Port:" in line:
            port = line.split(":", 1)[1].strip().lower()
            if "speaker" in port:
                return "Speaker"
            if "headphone" in port:
                return "Headphones"
    return "Earpiece"


DPCM_STATE = "/sys/kernel/debug/asoc/Fairphone 3/VoiceMMode1/state"
WATCH_MIXERS = [
    "SLIMBUS_0_RX Voice Mixer VoiceMMode1",
    "QUIN_MI2S_RX Voice Mixer VoiceMMode1",
    "VoiceMMode1 Capture Mixer SLIMBUS_0_TX",
    "SLIM RX0 MUX", "RX INT0_2 MUX", "ADC MUX0", "DMIC MUX0",
    "RX0 Mix Digital Volume", "EAR PA Volume",
]


def pulse_env():
    """Environment that lets this (root) daemon talk to the user's pulseaudio.

    The service runs as root, so pactl would look for a per-root pulseaudio and
    find nothing - and without pulseaudio the call cannot use its profile, which
    is what makes the volume keys work. Point it at the first user session's
    socket instead.
    """
    env = dict(os.environ)
    for d in sorted(glob.glob("/run/user/*")):
        sock = os.path.join(d, "pulse", "native")
        if not os.path.exists(sock):
            continue
        env["PULSE_SERVER"] = "unix:" + sock
        env["XDG_RUNTIME_DIR"] = d
        # ...and its cookie, or pulseaudio refuses the connection
        try:
            home = pwd.getpwuid(os.stat(d).st_uid).pw_dir
            cookie = os.path.join(home, ".config", "pulse", "cookie")
            if os.path.exists(cookie):
                env["PULSE_COOKIE"] = cookie
        except KeyError:
            pass
        break
    return env


def pactl(*args):
    try:
        return subprocess.run(["pactl"] + list(args), capture_output=True,
                              text=True, env=pulse_env()).stdout
    except FileNotFoundError:
        return ""


def pa_card():
    for line in pactl("list", "short", "cards").splitlines():
        f = line.split()
        if len(f) > 1 and "sound-card" in f[1]:
            return f[1]
    return None


def pa_profile(want_output):
    """The Voice Call profile pulseaudio offers for this output, if any.

    Switching the *profile* (rather than applying the verb behind pulseaudio's
    back) is what makes the volume keys work during a call: the profile's
    PlaybackVolume maps the sink volume onto the codec gain that sits in the
    voice path. It also keeps pulseaudio's idea of the routing and ours the
    same - applying the verb underneath a running pulseaudio let it re-apply
    HiFi routing over the call.
    """
    card = pa_card()
    if not card:
        return None, None
    mic = "Headset" if want_output == "Headphones" else "Mic"
    names = []
    for line in pactl("list", "cards").splitlines():
        line = line.strip()
        if line.startswith("Voice Call (") and ":" in line:
            names.append(line.split(":", 1)[0].strip())
    for n in names:
        inner = n[len("Voice Call ("):-1]
        parts = [p.strip() for p in inner.split(",")]
        if want_output in parts and mic in parts:
            return card, n
    return card, None


def pa_set_profile(card, profile):
    if not (card and profile):
        return False
    r = subprocess.run(["pactl", "set-card-profile", card, profile],
                       capture_output=True, text=True, env=pulse_env())
    if r.returncode:
        log("pactl set-card-profile %s failed: %s" % (profile, r.stderr.strip()))
        return False
    return True


def pa_active_profile():
    for line in pactl("list", "cards").splitlines():
        if "Active Profile:" in line:
            return line.split(":", 1)[1].strip()
    return None


def pa_streams(suspend):
    """Stop pulseaudio streaming on the card while the call owns the backend.

    The call and pulseaudio's media stream would otherwise share SLIMBUS_0_RX
    (and the standalone microphone source SLIMBUS_0_TX): whoever starts the AFE
    port first configures it, the other one gets ADSP_EALREADY, and the call is
    silent in both directions even though every route looks right.

    Suspending only the streams - not pulseaudio itself, and after the profile
    switch - keeps the volume keys working: pulseaudio still applies the sink
    volume to the codec gain of a suspended sink (verified on device).
    """
    arg = "1" if suspend else "0"
    for line in pactl("list", "short", "sinks").splitlines():
        f = line.split()
        if len(f) > 1 and "auto_null" not in f[1]:
            pactl("suspend-sink", f[1], arg)
    for line in pactl("list", "short", "sources").splitlines():
        f = line.split()
        if len(f) > 1 and "monitor" not in f[1]:
            pactl("suspend-source", f[1], arg)
    if not suspend:
        return
    # Wait for the PCMs to actually close. Opening the voice path while
    # pulseaudio still has the backend open means the AFE port was configured
    # by its media stream first; ours then gets ADSP_EALREADY and the downlink
    # stays silent - the failure is timing dependent, which is why the same
    # routing sometimes worked and sometimes did not.
    for _ in range(20):
        busy = [l for l in pactl("list", "short", "sinks").splitlines()
                if l.split() and "auto_null" not in l and "SUSPENDED" not in l]
        if not busy:
            time.sleep(0.3)      # let the backend finish tearing down
            return
        time.sleep(0.1)
    log("warning: pulseaudio streams still running after 2s")


def snapshot(tag):
    """One line per interesting control - the ground truth for a silent call."""
    try:
        with open(DPCM_STATE) as fh:
            state = [l.strip() for l in fh if l.strip().startswith(("[", "State:", "- "))]
        log("%s dpcm: %s" % (tag, " | ".join(state)))
    except OSError as e:
        log("%s dpcm: unreadable (%s)" % (tag, e))
    vals = []
    for c in WATCH_MIXERS:
        r = subprocess.run(["amixer", "-c", "0", "cget", "name=" + c],
                           capture_output=True, text=True)
        v = ""
        for line in r.stdout.splitlines():
            if ": values" in line:
                v = line.split("=", 1)[1]
                break
        vals.append("%s=%s" % (c.split()[0] + "/" + c.split()[-1], v))
    log("%s mixers: %s" % (tag, " ".join(vals)))


def open_leg(stream, label, playback):
    h = ctypes.c_void_p()
    rc = a.snd_pcm_open(ctypes.byref(h), PCM.encode(), stream, 0)
    if rc < 0:
        log("%s: open failed: %s" % (label, a.snd_strerror(rc).decode()))
        return None
    rc = a.snd_pcm_set_params(h, S16_LE, RW_INTERLEAVED, ctypes.c_uint(1),
                              ctypes.c_uint(8000), ctypes.c_int(1),
                              ctypes.c_uint(500000))
    if rc < 0:
        log("%s: set_params failed: %s" % (label, a.snd_strerror(rc).decode()))

    if playback:
        # Disable XRUN detection so an empty playback buffer can still start.
        sw = ctypes.create_string_buffer(a.snd_pcm_sw_params_sizeof())
        p = ctypes.cast(sw, ctypes.c_void_p)
        boundary = ctypes.c_ulong(0)
        a.snd_pcm_sw_params_current(h, p)
        a.snd_pcm_sw_params_get_boundary(p, ctypes.byref(boundary))
        a.snd_pcm_sw_params_set_stop_threshold(h, p, ctypes.c_ulong(boundary.value))
        a.snd_pcm_sw_params_set_start_threshold(h, p, ctypes.c_ulong(1))
        a.snd_pcm_sw_params(h, p)

    a.snd_pcm_prepare(h)
    rc = a.snd_pcm_start(h)
    if rc < 0:
        log("%s: start failed: %s" % (label, a.snd_strerror(rc).decode()))
    return h


# "RXn Mix Digital Volume" is 0..124 in 1 dB steps with 84 == 0 dB. Mapping the
# whole range put every setting between 0 and +40 dB, where the far end is
# already loud and clipping, so the keys felt dead. Use a range you can actually
# hear across: -24 dB at the bottom, +26 dB at the top.
RX_VOL_MAX = 110
RX_VOL_MIN = 60


def pa_sink_volume_pct():
    """Whatever the volume keys last set on pulseaudio's sink."""
    out = pactl("get-sink-volume", "@DEFAULT_SINK@")
    for tok in out.replace("/", " ").split():
        if tok.endswith("%"):
            try:
                return int(tok[:-1])
            except ValueError:
                pass
    return None


def mirror_volume(output, pct):
    """Apply pulseaudio's sink volume to the codec gain in the voice path.

    Handing pulseaudio the Voice Call profile would do this by itself, but that
    also puts its media sink on the same SLIMbus backend as the call, which
    reconfigures the codec's slim stream and leaves the earpiece silent (the
    speaker path over MI2S has no per-channel config and survives it). So keep
    pulseaudio off the backend and mirror the volume instead.
    """
    if output == "Speaker" or pct is None:
        return                       # the speaker amp has no gain control here
    ctl = "RX0 Mix Digital Volume" if output == "Earpiece" else "RX1 Mix Digital Volume"
    val = RX_VOL_MIN + (RX_VOL_MAX - RX_VOL_MIN) * max(0, min(100, pct)) // 100
    log("volume %d%% -> %s %d" % (pct, ctl.split()[0], val))
    subprocess.run(["amixer", "-c", "0", "cset", "name=" + ctl, str(val)],
                   capture_output=True)
    if output == "Headphones":
        subprocess.run(["amixer", "-c", "0", "cset",
                        "name=RX2 Mix Digital Volume", str(val)],
                       capture_output=True)


def _jack(name):
    out = subprocess.run(["amixer", "-c", "0", "cget", "iface=CARD,name=" + name],
                         capture_output=True, text=True).stdout
    return "values=on" in out.replace(" ", "")


def jack_state():
    """(something plugged, it has a microphone).

    The codec reports a *headset* (with mic) on "Headset Jack" and plain
    headphones on "Headphone Jack" - polling only the latter misses the common
    case entirely, which is why plugging a headset used to do nothing.
    """
    headset = _jack("Headset Jack")
    return (headset or _jack("Headphone Jack")), headset


def jack_plugged():
    return jack_state()[0]


def wanted_output(speaker, plugged):
    if speaker:
        return "Speaker"
    return "Headphones" if plugged else "Earpiece"


class ButtonWatch:
    """Watch the in-call buttons on the session bus.

    SpeakerState can be polled (callaudiod keeps it even though it cannot apply
    it here), but MicState is never updated on this device - callaudiod bails
    out before it gets that far. So watch the method calls themselves: that is
    what the app sends either way.
    """

    def __init__(self):
        self.mute = None
        self.speaker = None
        self.proc = None

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def start(self):
        uid = session_uid()
        if not uid:
            return              # no user session yet - main() retries
        try:
            gid = pwd.getpwuid(uid).pw_gid
        except KeyError:
            return

        def drop():
            os.setgid(gid)
            os.setuid(uid)

        env = dict(os.environ)
        env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=/run/user/%d/bus" % uid
        env["XDG_RUNTIME_DIR"] = "/run/user/%d" % uid
        try:
            self.proc = subprocess.Popen(
                ["dbus-monitor", "--session",
                 "destination='%s'" % CALLAUDIO[0]],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                env=env, preexec_fn=drop)
        except OSError as e:
            log("button watch unavailable: %s" % e)
            return
        log("watching the in-call buttons")
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        member = None
        for line in self.proc.stdout:
            line = line.strip()
            if "member=" in line:
                member = line.rsplit("member=", 1)[1].strip()
            elif line.startswith("boolean") and member:
                val = line.endswith("true")
                if member == "MuteMic":
                    set_mic_muted(val)          # instant, not on the next poll
                elif member == "EnableSpeaker":
                    self.speaker = val
                member = None


def set_mic_muted(muted):
    """Mute the uplink at the codec, where the call actually passes."""
    subprocess.run(["amixer", "-c", "0", "cset",
                    "name=AIF1_CAP Mixer SLIM TX0", "0" if muted else "1"],
                   capture_output=True)
    log("microphone %s" % ("muted" if muted else "unmuted"))


class Session:
    def __init__(self):
        self.pcm = []
        self.output = None
        self.forced_output = None
        self.prev_profile = None

    def up(self):
        return bool(self.pcm)

    def start(self):
        # a plugged headset wins over whatever pulseaudio was routed to
        self.output = self.forced_output or wanted_output(False, jack_plugged())
        mic = "Headset" if (self.output == "Headphones" and jack_state()[1]) else "Mic"
        # Order matters. Whoever starts the AFE port configures it, and a second
        # start only answers ADSP_EALREADY - so the voice path has to get there
        # first. Switching the pulseaudio profile opens its media sink on the
        # same backend, so: quiet pulseaudio, apply the routing ourselves, open
        # the call, and only then hand the profile over for the volume keys.
        pa_streams(True)
        if not ucm("set", "_verb", "Voice Call", "set", "_enadev", self.output,
                   "set", "_enadev", mic):
            pa_streams(False)
            return
        for stream, label, pb in ((PLAYBACK, "downlink", True),
                                  (CAPTURE, "uplink", False)):
            h = open_leg(stream, label, pb)
            if h:
                self.pcm.append(h)
        log("call audio up (%s + %s)" % (self.output, mic))

        mirror_volume(self.output, pa_sink_volume_pct())
        time.sleep(1)
        snapshot("up")

    def switch_output(self, output):
        """Move an in-call stream to another output.

        Two reasons this is a full stop-and-start rather than a re-route:

        * the ADSP builds the CVP with the RX port it was given when the session
          was created, so flipping the UCM device alone moves the codec routing
          but not the voice stream; and
        * reopening the frontend while the old device is still enabled leaves
          *both* backends attached to it (seen in the DPCM state as "Quinary
          MI2S" and "SLIM Playback" at once), after which the SLIMbus
          transactions time out and neither direction carries audio.

        So tear the whole session down - including dropping every device by
        going back to the HiFi verb - let it settle, then bring it up again.
        """
        log("output switch -> %s" % output)
        for h in self.pcm:
            a.snd_pcm_close(h)
        self.pcm = []
        ucm("set", "_verb", "HiFi")          # drops the call devices and their BEs
        time.sleep(0.4)
        self.forced_output = output
        self.start()

    def stop(self):
        snapshot("down")
        set_mic_muted(False)
        for h in self.pcm:
            a.snd_pcm_close(h)
        self.pcm = []
        self.forced_output = None
        ucm("set", "_verb", "HiFi")
        pa_streams(False)
        log("call audio down")


INACTIVE_STATES = {"ringing-in", "waiting", "terminated", "unknown"}
_last_call_log = [""]
_last_state = {}


def calls_active():
    """True while a call is up (dialing, ringing out, or answered).

    Deliberately permissive: anything the modem lists counts unless it is a
    state where audio must not be taken over yet (an incoming call still
    ringing, a waiting call, or one that is already gone). A call the daemon
    fails to notice is silent audio, so err on the side of engaging.
    """
    r = subprocess.run(["mmcli", "-m", "any", "--voice-list-calls"],
                       capture_output=True, text=True)
    out = (r.stdout or "") + (r.stderr or "")
    if r.returncode:
        if out.strip() != _last_call_log[0]:
            _last_call_log[0] = out.strip()
            log("mmcli failed (rc=%d): %s" % (r.returncode, out.strip()[:200]))
        return False
    if "no calls" in out.lower():
        _last_call_log[0] = ""
        return False

    paths = [w for w in out.split() if "/Call/" in w]
    if out.strip() != _last_call_log[0]:
        _last_call_log[0] = out.strip()
        log("calls: %s" % " ".join(paths) if paths else "calls: %s" % out.strip()[:200])

    active = False
    for path in paths:
        idx = path.rsplit("/", 1)[-1]
        c = subprocess.run(["mmcli", "-K", "--call", idx],
                           capture_output=True, text=True)
        state = ""
        for line in c.stdout.splitlines():
            if line.startswith("call.properties.state"):
                state = line.split(":", 1)[1].strip()
                break
        if state != _last_state.get(idx):
            _last_state[idx] = state
            log("  call %s state=%s" % (idx, state or "?"))
        if state and state not in INACTIVE_STATES:
            active = True
        elif not state:
            active = True          # cannot tell - assume it needs audio
    return active


def main():
    # Clean slate: a previous run (or a crash mid-call) can leave pulseaudio's
    # streams suspended and the Voice Call verb applied, which looks like a
    # completely silent phone - no ringtone, no media.
    ucm("set", "_verb", "HiFi")
    pa_streams(False)
    log("fp3-voiced: watching ModemManager for calls")
    session = Session()
    buttons = ButtonWatch()
    buttons.start()
    ticks = 0
    last_volume = None
    last_switch = 0.0
    speaker = False
    while True:
        if not buttons.alive():
            buttons.start()
        try:
            wanted = calls_active()
        except Exception as e:                      # never die on a transient
            log("poll error: %s" % e)
            wanted = session.up()
        if wanted and not session.up():
            speaker = False
            session.forced_output = None
            session.start()
            ticks = 0
            last_switch = time.time()
        elif not wanted and session.up():
            session.stop()
        elif session.up():
            if buttons.speaker is not None:
                speaker = buttons.speaker
                buttons.speaker = None
            want = wanted_output(speaker, jack_plugged())
            if want != session.output and time.time() - last_switch > 2:
                session.switch_output(want)
                last_switch = time.time()
            pct = pa_sink_volume_pct()
            if pct != last_volume:
                mirror_volume(session.output, pct)
                last_volume = pct
            ticks += 1
            if ticks % int(10 / POLL) == 0:
                snapshot("t+%ds" % int(ticks * POLL))
        time.sleep(POLL)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
