+/**
+ * \brief What the sensor can be asked for, in the units controls use
+ *
+ * The session configuration holds the same limits in sensor units (exposure in
+ * lines), and is only known once the camera is configured. These are needed
+ * earlier: the control ranges an application sees are published at init() time
+ * and never change afterwards.
+ *
+ * The exposure limits can move when the sensor is reconfigured to another
+ * resolution, so a value taken from here is a range for the user interface,
+ * not a promise - it is clamped to the session's limits when applied.
+ */
+struct IPASensorInfo {
+	bool present;
+	/* Exposure time in microseconds */
+	int32_t exposureMin;
+	int32_t exposureMax;
+	int32_t exposureDef;
+	/* Analogue gain as a multiplier, or as a raw code with no helper */
+	double gainMin;
+	double gainMax;
+	double gainDef;
+};
+
 struct IPAActiveState {
 	struct {
 		int32_t exposure;
 		double again;
 		bool valid;
+		/* Whether the application, rather than this IPA, decides them */
+		bool manualExposure;
+		bool manualGain;
 	} agc;
 
 	struct {
@@ -65,6 +92,8 @@ struct IPAActiveState {
 	struct {
 		RGB<float> gains;
 		unsigned int temperatureK;
+		/* Whether the application, rather than this IPA, decides them */
+		bool manual;
 	} awb;
 
 	Matrix<float, 3, 3> combinedMatrix;
@@ -112,6 +141,7 @@ struct IPAContext {
 
 	IPACameraSensorInfo sensorInfo;
 	IPALensInfo lens = {};
+	IPASensorInfo sensor = {};
 	IPASessionConfiguration configuration;
 	IPAActiveState activeState;
 	FCQueue<IPAFrameContext> frameContexts;
