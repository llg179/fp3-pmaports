 #include <stdint.h>
 
 #include <libcamera/base/log.h>
@@ -41,6 +43,107 @@ Agc::Agc()
 {
 }
 
+int Agc::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+{
+	/*
+	 * Without a sensor to ask, there is nothing to hand over: the exposure
+	 * and the gain stay this algorithm's business.
+	 */
+	if (!context.sensor.present)
+		return 0;
+
+	static const std::array<ControlValue, 2> kModes = {
+		ControlValue(static_cast<int32_t>(controls::ExposureTimeModeAuto)),
+		ControlValue(static_cast<int32_t>(controls::ExposureTimeModeManual)),
+	};
+	static const std::array<ControlValue, 2> kGainModes = {
+		ControlValue(static_cast<int32_t>(controls::AnalogueGainModeAuto)),
+		ControlValue(static_cast<int32_t>(controls::AnalogueGainModeManual)),
+	};
+
+	context.ctrlMap[&controls::ExposureTimeMode] =
+		ControlInfo(Span<const ControlValue>(kModes),
+			    ControlValue(static_cast<int32_t>(controls::ExposureTimeModeAuto)));
+	context.ctrlMap[&controls::AnalogueGainMode] =
+		ControlInfo(Span<const ControlValue>(kGainModes),
+			    ControlValue(static_cast<int32_t>(controls::AnalogueGainModeAuto)));
+
+	context.ctrlMap[&controls::ExposureTime] =
+		ControlInfo(context.sensor.exposureMin,
+			    context.sensor.exposureMax,
+			    context.sensor.exposureDef);
+	context.ctrlMap[&controls::AnalogueGain] =
+		ControlInfo(static_cast<float>(context.sensor.gainMin),
+			    static_cast<float>(context.sensor.gainMax),
+			    static_cast<float>(context.sensor.gainDef));
+
+	return 0;
+}
+
+int Agc::configure(IPAContext &context,
+		   [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	context.activeState.agc.manualExposure = false;
+	context.activeState.agc.manualGain = false;
+
+	return 0;
+}
+
+void Agc::queueRequest(typename Module::Context &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] typename Module::FrameContext &frameContext,
+		       const ControlList &controls)
+{
+	auto &agc = context.activeState.agc;
+
+	const auto &exposureMode = controls.get(controls::ExposureTimeMode);
+	if (exposureMode.has_value()) {
+		agc.manualExposure = exposureMode.value() == controls::ExposureTimeModeManual;
+		LOG(IPASoftExposure, Debug)
+			<< "Exposure time is now "
+			<< (agc.manualExposure ? "manual" : "automatic");
+	}
+
+	const auto &gainMode = controls.get(controls::AnalogueGainMode);
+	if (gainMode.has_value()) {
+		agc.manualGain = gainMode.value() == controls::AnalogueGainModeManual;
+		LOG(IPASoftExposure, Debug)
+			<< "Analogue gain is now "
+			<< (agc.manualGain ? "manual" : "automatic");
+	}
+
+	/*
+	 * A value that arrives while the quantity is automatic is dropped, as
+	 * the control definition requires - the algorithm would overwrite it on
+	 * the next frame anyway, and retaining it would make the metadata lie
+	 * about what the sensor was told.
+	 */
+	const auto &exposureTime = controls.get(controls::ExposureTime);
+	if (exposureTime.has_value() && agc.manualExposure) {
+		const double lineMicroseconds =
+			context.configuration.agc.lineDuration.get<std::micro>();
+		int32_t lines = lineMicroseconds > 0
+					? static_cast<int32_t>(exposureTime.value() / lineMicroseconds)
+					: context.configuration.agc.exposureMin;
+		agc.exposure = std::clamp(lines,
+					  context.configuration.agc.exposureMin,
+					  context.configuration.agc.exposureMax);
+		agc.valid = true;
+		LOG(IPASoftExposure, Debug)
+			<< "Setting exposure to " << exposureTime.value()
+			<< " us (" << agc.exposure << " lines)";
+	}
+
+	const auto &gain = controls.get(controls::AnalogueGain);
+	if (gain.has_value() && agc.manualGain) {
+		agc.again = std::clamp(static_cast<double>(gain.value()),
+				       context.configuration.agc.againMin,
+				       context.configuration.agc.againMax);
+		agc.valid = true;
+		LOG(IPASoftExposure, Debug) << "Setting analogue gain to " << agc.again;
+	}
+}
