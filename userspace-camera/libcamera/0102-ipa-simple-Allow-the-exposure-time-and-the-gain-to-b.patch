@@ -127,6 +127,42 @@ int IPASoftSimple::init(const IPASettings &settings,
 			<< context_.lens.max << " (default " << context_.lens.def << ")";
 	}
 
+	/*
+	 * Describe the sensor's exposure and gain the same way, and for the
+	 * same reason: an algorithm that offers manual control of them has to
+	 * publish their range before the camera is ever configured.
+	 */
+	const auto &exposure = sensorControls.find(V4L2_CID_EXPOSURE);
+	const auto &gain = sensorControls.find(V4L2_CID_ANALOGUE_GAIN);
+	if (exposure != sensorControls.end() && gain != sensorControls.end()) {
+		const utils::Duration lineDuration =
+			sensorInfo.minLineLength * 1.0s / sensorInfo.pixelRate;
+		const auto toMicroseconds = [&](int32_t lines) {
+			return static_cast<int32_t>((lineDuration * lines).get<std::micro>());
+		};
+		const auto toGain = [&](int32_t code) {
+			return camHelper_ ? camHelper_->gain(code)
+					  : static_cast<double>(code);
+		};
+
+		context_.sensor.present = true;
+		context_.sensor.exposureMin =
+			std::max(toMicroseconds(exposure->second.min().get<int32_t>()), 1);
+		context_.sensor.exposureMax =
+			toMicroseconds(exposure->second.max().get<int32_t>());
+		context_.sensor.exposureDef =
+			toMicroseconds(exposure->second.def().get<int32_t>());
+		context_.sensor.gainMin = toGain(gain->second.min().get<int32_t>());
+		context_.sensor.gainMax = toGain(gain->second.max().get<int32_t>());
+		context_.sensor.gainDef = toGain(gain->second.def().get<int32_t>());
+
+		LOG(IPASoft, Info)
+			<< "Sensor exposure " << context_.sensor.exposureMin << "-"
