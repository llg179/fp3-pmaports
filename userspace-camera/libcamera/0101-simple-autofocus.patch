+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(typename Module::Context &context, const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class ScanPhase {
+		Idle,
+		Coarse,
+		Fine,
+	};
+
+	double score(const SwIspStats *stats) const;
+	static double luminance(const SwIspStats *stats);
+	static RGB<double> average(const SwIspStats *stats);
+	bool sceneChanged(const RGB<double> &a, const RGB<double> &b) const;
+	int32_t interpolatePeak() const;
+	bool exposureSteady(double exposure, double gain);
+	void detrend();
+	void selectZones(IPAContext &context, Span<const Rectangle> windows);
+
+	void startScan(IPAContext &context);
+	void planScan(int32_t centre, int32_t span, unsigned int steps);
+	void moveTo(IPAContext &context, int32_t position);
+
+	/* Which focus zones the score is taken over */
+	std::array<bool, SwIspStats::kAfZonesX * SwIspStats::kAfZonesY> zones_;
+
+	ScanPhase phase_ = ScanPhase::Idle;
+	std::vector<int32_t> positions_;
+	std::vector<double> scores_;
+	unsigned int bestIndex_ = 0;
+	unsigned int index_ = 0;
+	unsigned int settle_ = 0;
+
+	/* Tuning-file overrides */
+	unsigned int settleFrames_ = 0;
+	double rescanThreshold_ = 0.3;
+	double minContrast_ = 0.08;
+
+	int32_t min_ = 0;
+	int32_t max_ = 0;
+	double bestScore_ = 0.0;
+	double worstScore_ = 0.0;
+	int32_t bestPosition_ = 0;
+	int32_t startPosition_ = 0;
+	int32_t coarseStep_ = 0;
+
+	/* The score the scan settled on, and how long it has disagreed */
+	double focusedScore_ = 0.0;
+	RGB<double> sceneAverage_;
+	unsigned int startupSkip_ = 0;
+	double lastExposure_ = 0.0;
+	double lastGain_ = 0.0;
+	double drift_ = 0.0;
+	unsigned int steadyCount_ = 0;
+	unsigned int steadyWait_ = 0;
+	unsigned int disagreed_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
