+/**
+ * \file af.cpp
+ * \brief Contrast-detection autofocus
+ *
+ * The software ISP measures the sharpness of every statistics frame as the sum
+ * of squared luminance differences between horizontally neighbouring samples.
+ * That value peaks when the image is in focus, so focusing is a hill climb: try
+ * a coarse ladder of lens positions across the whole range, then a finer ladder
+ * around the best of them, and stay at the winner.
+ *
+ * The scan is deliberately not a single ordered walk with an early exit. The
+ * response has one interior peak and long flat tails, so a walk that stops as
+ * soon as the score falls settles on whichever local wobble it meets first, and
+ * a comparison of the two extremes is blind to the peak between them.
+ *
+ * The metric is normalised by the square of the total luminance, because the
+ * AGC keeps adjusting exposure and gain while the scan runs and an unnormalised
+ * sum of squared differences scales with brightness.
+ */
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace {
+
+/* Positions tried across the whole range in the coarse pass */
+constexpr unsigned int kCoarseSteps = 12;
+/* Positions tried across one coarse step either side of the coarse winner */
+constexpr unsigned int kFineSteps = 7;
+/*
+ * Statistics frames to discard after moving the lens.
+ *
+ * Statistics are produced once every SwStatsCpu::kStatPerNumFrames frames, so
+ * at 30 fps a step of the scan already gives the lens some 130 ms to settle
+ * before the next measurement, and no extra frame is needed. A full-range jump
+ * at the start of a scan is given one.
+ */
+constexpr unsigned int kSettleFrames = 0;
+constexpr unsigned int kInitialSettleFrames = 1;
+/* Relative change in score that counts as the scene having changed */
+constexpr double kRescanThreshold = 0.5;
+/*
+ * How far the best position of a scan has to stand above the worst for the
+ * scan to be believed.
+ *
+ * A scene with no detail at the scale the metric measures - a blank wall, or
+ * anything in the dark - gives a flat response, and the maximum of a flat
+ * response is wherever the noise happened to peak. Measured on a Fairphone 3:
+ * a scene with detail spans 12% to 23% between the best and the worst position
+ * of a coarse pass, while a featureless one spans under 4%.
+ */
+constexpr double kMinContrast = 0.08;
+/*
+ * Mean sample luminance, 0..255, below which a scan is not attempted at all.
+ *
+ * The score divides sharpness by the square of the luminance, which is right
+ * for signal - the differences scale with brightness - but wrong for noise,
+ * which does not. In a dark frame the quotient therefore grows large and is
+ * entirely noise.
+ */
+constexpr double kMinLuminance = 12.0;
+/*
+ * Consecutive disagreeing measurements before a continuous rescan, and how far
+ * a value has to move to disagree.
+ *
+ * Both the thresholds and the shape of this test are taken from the Raspberry
+ * Pi AF algorithm (src/ipa/rpi/controller/rpi/af.cpp, retriggerRatio 0.75 and
+ * retriggerDelay 10), which has been in the field far longer than this one.
+ */
+constexpr unsigned int kRescanSamples = 10;
+constexpr double kRetriggerRatio = 0.75;
+/*
+ * Statistics frames to ignore after a session starts.
+ *
+ * The AGC needs several of them to converge, and a scan run underneath a
+ * moving exposure measures the exposure rather than the focus. The Raspberry
+ * Pi algorithm skips 5 frames for the same reason.
+ */
+constexpr unsigned int kStartupSkip = 6;
+/*
+ * How steady the exposure has to be before a scan is worth starting, and how
+ * long to wait for it.
+ *
+ * A scan is a walk through the positions in order, so anything that drifts
+ * while it runs is indistinguishable from a response to the lens. The AGC
+ * converging after a session starts drifts by a factor of two over a few
+ * seconds in a dim room, which reads as a perfectly monotonic curve and puts
+ * the "peak" at whichever end the scan finished on. Measured on a Fairphone 3,
+ * 2026-08-01: the same lens position scored 3517 early in a scan and 3992 four
+ * seconds later.
+ */
+constexpr double kSteadyExposure = 0.02;
+constexpr unsigned int kSteadySamples = 2;
+constexpr unsigned int kSteadyTimeout = 40;
+/*
+ * How much larger the response to the lens has to be than whatever drifted
+ * during the pass, for the pass to mean anything.
+ *
+ * Correcting a linear drift is not the same as the drift not having happened:
+ * what is left is the non-linear part, and if the correction was larger than
+ * the signal then the "peak" is a residue of it. Measured 2026-08-01 in a dim
+ * room, where the AGC's gain ramp moved the score by a factor of two across a
+ * pass while the lens moved it by a tenth of that.
+ */
+constexpr double kDriftRatio = 1.0;
+
+} /* namespace */
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	if (!context.lens.present) {
+		LOG(IPASoftAf, Info)
+			<< "No focus lens, autofocus disabled";
+		return 0;
+	}
+
+	settleFrames_ = tuningData["settle-frames"].get<uint32_t>(kSettleFrames);
+	rescanThreshold_ = tuningData["rescan-threshold"].get<double>(kRescanThreshold);
+	minContrast_ = tuningData["min-contrast"].get<double>(kMinContrast);
+
+	static const std::array<ControlValue, 3> kAfModes = {
+		ControlValue(static_cast<int32_t>(controls::AfModeManual)),
+		ControlValue(static_cast<int32_t>(controls::AfModeAuto)),
+		ControlValue(static_cast<int32_t>(controls::AfModeContinuous)),
+	};
+	static const std::array<ControlValue, 2> kAfMeterings = {
+		ControlValue(static_cast<int32_t>(controls::AfMeteringAuto)),
+		ControlValue(static_cast<int32_t>(controls::AfMeteringWindows)),
+	};
+	static const std::array<ControlValue, 2> kAfTriggers = {
+		ControlValue(static_cast<int32_t>(controls::AfTriggerStart)),
+		ControlValue(static_cast<int32_t>(controls::AfTriggerCancel)),
+	};
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(Span<const ControlValue>(kAfModes),
+			    ControlValue(static_cast<int32_t>(controls::AfModeContinuous)));
+
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(Span<const ControlValue>(kAfTriggers),
+			    ControlValue(static_cast<int32_t>(controls::AfTriggerCancel)));
+
+	context.ctrlMap[&controls::AfMetering] =
+		ControlInfo(Span<const ControlValue>(kAfMeterings),
+			    ControlValue(static_cast<int32_t>(controls::AfMeteringAuto)));
+
+	/*
+	 * One window, in pixels of the sensor's output. The bounds are filled
+	 * in at configure() time, once the output size is known.
+	 */
+	context.ctrlMap[&controls::AfWindows] =
+		ControlInfo(Rectangle(), Rectangle(), Rectangle());
+
+	return 0;
+}
+
+/**
+ * \brief Choose the focus zones the score is taken over
+ * \param[in] windows The requested windows, empty for the whole frame
+ *
+ * A window is given in pixels of the sensor's output, which is what an
+ * application can compute a tap position in. Any zone the window touches is
+ * selected; a tap therefore always selects at least one zone, however small
+ * the window it is turned into.
+ */
+void Af::selectZones(IPAContext &context, Span<const Rectangle> windows)
+{
+	if (windows.empty()) {
+		zones_.fill(true);
+		return;
+	}
+
+	const Size &size = context.sensorInfo.outputSize;
+	if (size.isNull()) {
+		zones_.fill(true);
+		return;
+	}
+
+	zones_.fill(false);
+
+	for (const Rectangle &window : windows) {
+		Rectangle w = window.boundedTo(Rectangle(size));
+		if (w.isNull())
+			continue;
+
+		unsigned int x0 = w.x * SwIspStats::kAfZonesX / size.width;
+		unsigned int x1 = (w.x + w.width - 1) * SwIspStats::kAfZonesX / size.width;
+		unsigned int y0 = w.y * SwIspStats::kAfZonesY / size.height;
+		unsigned int y1 = (w.y + w.height - 1) * SwIspStats::kAfZonesY / size.height;
+
+		x1 = std::min(x1, SwIspStats::kAfZonesX - 1);
+		y1 = std::min(y1, SwIspStats::kAfZonesY - 1);
+
+		for (unsigned int y = y0; y <= y1; y++)
+			for (unsigned int x = x0; x <= x1; x++)
+				zones_[y * SwIspStats::kAfZonesX + x] = true;
+	}
+
+	if (std::none_of(zones_.begin(), zones_.end(), [](bool z) { return z; }))
+		zones_.fill(true);
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	auto &af = context.activeState.af;
+
+	af.mode = context.lens.present ? controls::AfModeContinuous
+				       : controls::AfModeManual;
+	af.state = controls::AfStateIdle;
+	af.position = context.lens.def;
+	af.updateLens = false;
+
+	zones_.fill(true);
+
+	phase_ = ScanPhase::Idle;
+	positions_.clear();
+	index_ = 0;
+	settle_ = 0;
+	bestScore_ = 0.0;
+	bestPosition_ = context.lens.def;
+	focusedScore_ = 0.0;
+	sceneAverage_ = RGB<double>({ 0.0, 0.0, 0.0 });
+	disagreed_ = 0;
+	startupSkip_ = kStartupSkip;
+	lastExposure_ = 0.0;
+	lastGain_ = 0.0;
+	steadyCount_ = 0;
+	steadyWait_ = 0;
+
+	return 0;
+}
+
+void Af::queueRequest(typename Module::Context &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] typename Module::FrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.lens.present)
+		return;
+
+	auto &af = context.activeState.af;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode.has_value()) {
+		auto value = static_cast<controls::AfModeEnum>(mode.value());
+		if (value != af.mode) {
+			LOG(IPASoftAf, Debug) << "AfMode set to " << value;
+			af.mode = value;
+			phase_ = ScanPhase::Idle;
+			af.state = controls::AfStateIdle;
+			disagreed_ = 0;
+		}
+	}
+
+	const auto &metering = controls.get(controls::AfMetering);
+	if (metering.has_value() &&
+	    metering.value() == controls::AfMeteringAuto) {
+		zones_.fill(true);
+	}
+
+	const auto &windows = controls.get(controls::AfWindows);
+	if (windows.has_value()) {
+		auto previous = zones_;
+		selectZones(context, windows.value());
+
+		/*
+		 * Pointing the metering somewhere else is a statement about
+		 * what should be in focus, so act on it rather than waiting
+		 * for the scene-change detector to notice.
+		 */
+		if (zones_ != previous && af.mode == controls::AfModeContinuous)
+			startScan(context);
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger.has_value() && af.mode == controls::AfModeAuto) {
+		if (trigger.value() == controls::AfTriggerStart) {
+			if (phase_ == ScanPhase::Idle)
+				startScan(context);
+		} else {
+			phase_ = ScanPhase::Idle;
+			af.state = controls::AfStateIdle;
+		}
+	}
+}
+
+double Af::score(const SwIspStats *stats) const
+{
+	double luma = static_cast<double>(stats->sum_.r()) +
+		      static_cast<double>(stats->sum_.g()) +
+		      static_cast<double>(stats->sum_.b());
+
+	if (luma < 1.0)
+		return 0.0;
+
+	uint64_t sharpness = 0;
+	for (unsigned int zone = 0; zone < stats->afZones.size(); zone++)
+		if (zones_[zone])
+			sharpness += stats->afZones[zone];
+
+	/*
+	 * The 1e12 factor has no meaning beyond keeping the logged value in a
+	 * range a human can read; only ratios of scores are ever used.
+	 *
+	 * Normalising by the luminance of the *whole* window rather than of
+	 * the selected zones is deliberate: it is the exposure that has to be
+	 * divided out, and the AGC drives that from the whole window too.
+	 */
+	return static_cast<double>(sharpness) / (luma * luma) * 1e12;
+}
+
+RGB<double> Af::average(const SwIspStats *stats)
+{
+	uint64_t samples = 0;
+
+	for (unsigned int i = 0; i < SwIspStats::kYHistogramSize; i++)
+		samples += stats->yHistogram[i];
+
+	if (!samples)
+		return RGB<double>({ 0.0, 0.0, 0.0 });
+
+	return RGB<double>({ static_cast<double>(stats->sum_.r()) / samples,
+			     static_cast<double>(stats->sum_.g()) / samples,
+			     static_cast<double>(stats->sum_.b()) / samples });
+}
+
+/**
+ * \brief Whether two frame averages are far enough apart to be a new scene
+ *
+ * The test is the Raspberry Pi algorithm's: a ratio rather than a difference,
+ * applied per channel, with a +1 that keeps it meaningful near black.
+ */
+bool Af::sceneChanged(const RGB<double> &a, const RGB<double> &b) const
+{
+	for (unsigned int i = 0; i < 3; i++) {
+		if (a[i] + 1.0 < kRetriggerRatio * b[i] ||
+		    b[i] + 1.0 < kRetriggerRatio * a[i])
+			return true;
+	}
+
+	return false;
+}
+
+/**
+ * \brief Whether the exposure has stopped moving
+ *
+ * Returns true once the mean luminance has held still for a few statistics
+ * frames, or once waiting has gone on long enough that a drifting scan is
+ * better than no scan at all.
+ */
+bool Af::exposureSteady(double exposure, double gain)
+{
+	/*
+	 * Watch the exposure and the gain themselves rather than the
+	 * brightness they produce: holding the brightness still is the AGC's
+	 * whole purpose, so a stable luminance says nothing. What moves the
+	 * focus measure while the AGC converges is the gain, because the noise
+	 * it amplifies has no focus.
+	 */
+	bool steady = lastExposure_ > 0.0 && lastGain_ > 0.0 &&
+		      std::abs(exposure - lastExposure_) < kSteadyExposure * lastExposure_ &&
+		      std::abs(gain - lastGain_) < kSteadyExposure * lastGain_;
+
+	lastExposure_ = exposure;
+	lastGain_ = gain;
+
+	if (steady)
+		steadyCount_++;
+	else
+		steadyCount_ = 0;
+
+	if (steadyWait_ < kSteadyTimeout)
+		steadyWait_++;
+
+	return steadyCount_ >= kSteadySamples || steadyWait_ >= kSteadyTimeout;
+}
+
+double Af::luminance(const SwIspStats *stats)
+{
+	uint64_t samples = 0;
+	uint64_t weighted = 0;
+
+	for (unsigned int i = 0; i < SwIspStats::kYHistogramSize; i++) {
+		samples += stats->yHistogram[i];
+		weighted += static_cast<uint64_t>(stats->yHistogram[i]) *
+			    (i * 256 / SwIspStats::kYHistogramSize +
+			     128 / SwIspStats::kYHistogramSize);
+	}
+
+	if (!samples)
+		return 0.0;
+
+	return static_cast<double>(weighted) / samples;
+}
+
+void Af::planScan(int32_t centre, int32_t span, unsigned int steps)
+{
+	positions_.clear();
+
+	int32_t lo = std::max(min_, centre - span);
+	int32_t hi = std::min(max_, centre + span);
+
+	if (hi <= lo) {
+		positions_.push_back(std::clamp(centre, min_, max_));
+		return;
+	}
+
+	for (unsigned int i = 0; i < steps; i++) {
+		int32_t pos = lo + (hi - lo) * static_cast<int32_t>(i) /
+					  static_cast<int32_t>(steps - 1);
+		if (positions_.empty() || positions_.back() != pos)
+			positions_.push_back(pos);
+	}
+
+	/*
+	 * Visit the first position once more at the end. The two visits differ
+	 * only in when they happened, so their difference measures whatever
+	 * drifted during the pass, and the samples in between can be corrected
+	 * for it. The revisit is not itself a candidate.
+	 */
+	if (positions_.size() >= 3)
+		positions_.push_back(positions_.front());
+}
+
+/**
+ * \brief Remove a linear drift in time from the samples of a pass
+ *
+ * The last sample repeats the first position, so any difference between them
+ * is time rather than focus. Subtracting a ramp through the two leaves the
+ * response to the lens.
+ */
+void Af::detrend()
+{
+	drift_ = 0.0;
+
+	if (scores_.size() < 3)
+		return;
+
+	unsigned int last = scores_.size() - 1;
+	double drift = scores_[last] - scores_[0];
+
+	drift_ = std::abs(drift);
+	scores_.pop_back();
+
+	if (std::abs(drift) >= 1e-9) {
+		LOG(IPASoftAf, Debug)
+			<< "Pass drifted by " << drift << " over " << last
+			<< " samples; correcting";
+
+		for (unsigned int i = 0; i < scores_.size(); i++)
+			scores_[i] -= drift * static_cast<double>(i) / last;
+	}
+
+	/*
+	 * The sample just dropped was a candidate while the pass was running
+	 * and may be the one that scored best, so the best has to be found
+	 * again over what is left - whether or not there was drift to correct.
+	 * A stale index points at a sample that no longer exists.
+	 */
+	bestScore_ = 0.0;
+	worstScore_ = 0.0;
+	bestIndex_ = 0;
+
+	for (unsigned int i = 0; i < scores_.size(); i++) {
+		if (scores_[i] > bestScore_) {
+			bestScore_ = scores_[i];
+			bestIndex_ = i;
+			bestPosition_ = positions_[i];
+		}
+		if (worstScore_ == 0.0 || scores_[i] < worstScore_)
+			worstScore_ = scores_[i];
+	}
+}
+
+/**
+ * \brief Interpolate the peak between the best sample and its neighbours
+ *
+ * Fitting a parabola through the best sample and the one either side puts the
+ * peak between the positions actually visited, so the result is not limited to
+ * the step of the scan. Adapted from the Raspberry Pi AF algorithm's
+ * findPeak(), which in turn adapts interpolateQuadratic() from its AWB.
+ */
+int32_t Af::interpolatePeak() const
+{
+	/*
+	 * What bounds this is scores_, not positions_: planScan() appends a
+	 * revisit of the first position and detrend() drops its sample, so
+	 * scores_ is one entry shorter. Taking the bound from positions_ let
+	 * the neighbour lookups below read one past the end of scores_, which
+	 * is what a peak at the last swept position did every time.
+	 */
+	if (scores_.empty())
+		return bestPosition_;
+
+	unsigned int i = bestIndex_;
+
+	if (scores_.size() < 3)
+		return positions_[i];
+
+	if (i == 0)
+		i++;
+	else if (i + 1 >= scores_.size())
+		i--;
+
+	double abx = positions_[i - 1] - positions_[i];
+	double aby = scores_[i - 1] - scores_[i];
+	double cbx = positions_[i + 1] - positions_[i];
+	double cby = scores_[i + 1] - scores_[i];
+
+	double denom = 2.0 * (aby * cbx - cby * abx);
+	if (std::abs(denom) < 1e-9 || denom * abx <= 0.0)
+		return positions_[bestIndex_];
+
+	double f = (aby * cbx * cbx - cby * abx * abx) / denom;
+	f = std::clamp(f, std::min(abx, cbx), std::max(abx, cbx));
+
+	return static_cast<int32_t>(std::lround(positions_[i] + f));
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	auto &af = context.activeState.af;
+
+	af.position = std::clamp(position, min_, max_);
+	af.updateLens = true;
+	settle_ = settleFrames_;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	min_ = context.lens.min;
+	max_ = context.lens.max;
+
+	coarseStep_ = (max_ - min_) / static_cast<int32_t>(kCoarseSteps - 1);
+
+	phase_ = ScanPhase::Coarse;
+	planScan((min_ + max_) / 2, (max_ - min_ + 1) / 2, kCoarseSteps);
+	index_ = 0;
+	scores_.clear();
+	bestIndex_ = 0;
+	bestScore_ = 0.0;
+	worstScore_ = 0.0;
+	startPosition_ = context.activeState.af.position;
+	bestPosition_ = positions_.front();
+
+	context.activeState.af.state = controls::AfStateScanning;
+	steadyCount_ = 0;
+	steadyWait_ = 0;
+
+	moveTo(context, positions_.front());
+	settle_ = kInitialSettleFrames;
+
+	LOG(IPASoftAf, Debug)
+		<< "Starting scan over " << positions_.size() << " positions, "
+		<< min_ << ".." << max_;
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	auto &af = context.activeState.af;
+
+	if (!context.lens.present)
+		return;
+
+	metadata.set(controls::AfState, af.state);
+
+	if (af.mode == controls::AfModeManual || !stats->valid)
+		return;
+
+	if (startupSkip_) {
+		startupSkip_--;
+		return;
+	}
+
+	double value = score(stats);
+
+	if (phase_ == ScanPhase::Idle) {
+		/*
+		 * Continuous mode: start a scan when there has not been one,
+		 * and watch for the scene changing under a finished one.
+		 */
+		if (af.mode != controls::AfModeContinuous)
+			return;
+
+		if (af.state == controls::AfStateIdle) {
+			double luma = luminance(stats);
+
+			if (luma < kMinLuminance) {
+				LOG(IPASoftAf, Debug)
+					<< "Too dark to focus, waiting";
+				return;
+			}
+
+			if (!exposureSteady(frameContext.sensor.exposure,
+					    frameContext.sensor.gain)) {
+				LOG(IPASoftAf, Debug)
+					<< "Exposure still moving (exposure "
+					<< frameContext.sensor.exposure << ", gain "
+					<< frameContext.sensor.gain << "), waiting";
+				return;
+			}
+
+			startScan(context);
+			metadata.set(controls::AfState, af.state);
+			return;
+		}
+
+		if (focusedScore_ <= 0.0)
+			return;
+
+		/*
+		 * Deciding that the scene changed from the focus score alone
+		 * cannot work: the score is what focusing changes, so a scan
+		 * that succeeded looks exactly like a scene that moved. Watch
+		 * the colour averages for the scene, and the score only for it
+		 * collapsing.
+		 */
+		RGB<double> now = average(stats);
+		bool changed = sceneChanged(now, sceneAverage_) ||
+			       value + 1.0 < rescanThreshold_ * focusedScore_;
+
+		if (changed) {
+			if (++disagreed_ >= kRescanSamples) {
+				LOG(IPASoftAf, Debug)
+					<< "Scene changed, rescanning";
+				startScan(context);
+				metadata.set(controls::AfState, af.state);
+			}
+		} else {
+			disagreed_ = 0;
+		}
+
+		return;
+	}
+
+	if (settle_) {
+		settle_--;
+		return;
+	}
+
+	LOG(IPASoftAf, Debug)
+		<< "Position " << positions_[index_] << " scores " << value;
+
+	scores_.push_back(value);
+
+	if (value > bestScore_) {
+		bestScore_ = value;
+		bestIndex_ = index_;
+		bestPosition_ = positions_[index_];
+	}
+
+	if (phase_ == ScanPhase::Coarse &&
+	    (worstScore_ == 0.0 || value < worstScore_))
+		worstScore_ = value;
+
+	if (++index_ < positions_.size()) {
+		moveTo(context, positions_[index_]);
+		return;
+	}
+
+	detrend();
+
+	if (phase_ == ScanPhase::Coarse) {
+		phase_ = ScanPhase::Fine;
+		planScan(bestPosition_, coarseStep_, kFineSteps);
+		index_ = 0;
+		scores_.clear();
+		bestIndex_ = 0;
+		bestScore_ = 0.0;
+		moveTo(context, positions_.front());
+		return;
+	}
+
+	phase_ = ScanPhase::Idle;
+	disagreed_ = 0;
+
+	/*
+	 * Believe the scan only if the response actually has a peak. Without
+	 * this the lens is driven to wherever the noise of a featureless scene
+	 * happened to be highest, which is worse than not moving at all.
+	 */
+	if ((worstScore_ > 0.0 &&
+	     bestScore_ < worstScore_ * (1.0 + minContrast_)) ||
+	    bestScore_ - worstScore_ < kDriftRatio * drift_) {
+		LOG(IPASoftAf, Info)
+			<< "No focus peak (" << worstScore_ << ".." << bestScore_
+			<< ", drift " << drift_ << "), staying at " << startPosition_;
+
+		moveTo(context, startPosition_);
+		focusedScore_ = value;
+		af.state = controls::AfStateFailed;
+		metadata.set(controls::AfState, af.state);
+		return;
+	}
+
+	int32_t peak = interpolatePeak();
+
+	moveTo(context, peak);
+	focusedScore_ = bestScore_;
+	sceneAverage_ = average(stats);
+	af.state = controls::AfStateFocused;
+	metadata.set(controls::AfState, af.state);
+
+	LOG(IPASoftAf, Info)
+		<< "Focused at " << peak << " (best sample " << bestPosition_
+		<< ", score " << bestScore_ << ")";
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
