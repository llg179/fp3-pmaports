+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Lajosházi, László Gergely
+ *
+ * Contrast-detection autofocus for the software ISP
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
