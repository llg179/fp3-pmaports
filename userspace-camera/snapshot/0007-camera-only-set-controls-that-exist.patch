         /// Index being tried while looking for a preview size that streams.
         pub probe: Cell<Option<usize>>,
         /// Buffers the video sink has seen; only ever read to judge a probe.
@@ -1406,6 +1408,7 @@ impl Viewfinder {
         );
 
         imp.resolutions.replace(resolutions);
+        imp.controls.borrow_mut().clear();
         imp.capture_res.set(0);
         self.set_autofocus(imp.autofocus.get());
         imp.restore_res.set(None);
@@ -1659,12 +1662,20 @@ impl Viewfinder {
     }
 
     /// What the camera in use offers to be set, as it describes itself.
+    ///
+    /// Asked once and kept: every write has to check that what it is about to
+    /// set exists, and asking PipeWire on every tap would mean a process per
+    /// tap.
     pub fn camera_controls(&self) -> Vec<crate::camera_control::CameraControl> {
-        let Some(node_id) = self.camera().and_then(|camera| camera.node_id()) else {
-            return Vec::new();
-        };
+        let imp = self.imp();
+
+        if imp.controls.borrow().is_empty() {
+            if let Some(node_id) = self.camera().and_then(|camera| camera.node_id()) {
+                imp.controls.replace(crate::camera_control::discover(node_id));
+            }
+        }
 
-        crate::camera_control::discover(node_id)
+        imp.controls.borrow().clone()
     }
 
     /// Sets one of those controls.
@@ -1690,7 +1701,8 @@ impl Viewfinder {
             return;
         };
 
-        crate::camera_control::request_autofocus(node_id, request);
+        let controls = self.camera_controls();
+        crate::camera_control::request_autofocus(node_id, request, &controls);
     }
 
     fn size_caps(size: crate::utils::Size) -> gst::Caps {
