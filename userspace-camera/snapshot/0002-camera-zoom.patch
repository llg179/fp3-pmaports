@@ -160,6 +166,79 @@ mod imp {
 
             obj.add_controller(controller);
 
+            // Zoom: pinch on a touchscreen, scroll wheel on a desktop, double
+            // tap to toggle between 1x and 2x. All three end up on camerabin's
+            // own `zoom` property, so what is framed is what gets saved.
+            //
+            // The controllers go on the page rather than on the viewfinder:
+            // the viewfinder is covered by a full-area overlay carrying the
+            // controls, so a controller attached to it never sees a touch.
+            let zoom_gesture = gtk::GestureZoom::new();
+            zoom_gesture.set_propagation_phase(gtk::PropagationPhase::Capture);
+            let zoom_start = std::rc::Rc::new(std::cell::Cell::new(1.0_f64));
+            zoom_gesture.connect_begin(glib::clone!(
+                #[weak]
+                obj,
+                #[strong]
+                zoom_start,
+                move |_, _| {
+                    zoom_start.set(obj.imp().viewfinder.zoom());
+                }
+            ));
+            zoom_gesture.connect_scale_changed(glib::clone!(
+                #[weak]
+                obj,
+                #[strong]
+                zoom_start,
+                move |_, scale| {
+                    let zoom = zoom_start.get() * scale;
+                    log::debug!("pinch: scale {scale:.2} -> zoom {zoom:.2}");
+                    obj.imp().viewfinder.set_zoom(zoom);
+                }
+            ));
+            obj.add_controller(zoom_gesture);
+
+            let scroll = gtk::EventControllerScroll::new(
+                gtk::EventControllerScrollFlags::VERTICAL,
+            );
+            scroll.connect_scroll(glib::clone!(
+                #[weak]
+                obj,
+                #[upgrade_or]
+                glib::Propagation::Proceed,
+                move |_, _dx, dy| {
+                    let viewfinder = &obj.imp().viewfinder;
+                    viewfinder.set_zoom(viewfinder.zoom() * (1.0 - dy * 0.1));
+                    glib::Propagation::Stop
+                }
+            ));
+            obj.add_controller(scroll);
+
+            let double_tap = gtk::GestureClick::new();
+            double_tap.set_button(gtk::gdk::BUTTON_PRIMARY);
+            double_tap.connect_pressed(glib::clone!(
+                #[weak]
+                obj,
+                move |_, n_press, _, _| {
+                    if n_press != 2 {
+                        return;
+                    }
+
+                    let viewfinder = &obj.imp().viewfinder;
+                    let zoom = if viewfinder.zoom() > 1.0 { 1.0 } else { 2.0 };
+                    viewfinder.set_zoom(zoom);
+                }
+            ));
+            obj.add_controller(double_tap);
+
+            self.viewfinder.connect_zoom_notify(glib::clone!(
+                #[weak]
+                obj,
+                move |viewfinder| {
+                    obj.show_zoom_level(viewfinder.zoom());
+                }
+            ));
+
             provider.connect_camera_added(glib::clone!(
                 #[weak]
                 obj,
@@ -464,6 +543,11 @@ impl Camera {
             self.stop_recording();
         }
 
+        // A zoom factor is a property of the camera you were pointing, not of
+        // the app; carrying it over to a different sensor is never what the
+        // user meant.
+        imp.viewfinder.set_zoom(1.0);
+
         imp.viewfinder.set_camera(camera);
     }
 
@@ -615,6 +699,37 @@ impl Camera {
         }
     }
 
+    /// Shows the zoom factor over the viewfinder, briefly.
+    fn show_zoom_level(&self, zoom: f64) {
+        let imp = self.imp();
+
+        if let Some(source) = imp.zoom_source.take() {
+            source.remove();
+        }
+
+        log::info!("zoom is now {zoom:.2}x");
+        imp.zoom_label.set_label(&format!("{zoom:.1}\u{00d7}"));
+        imp.zoom_revealer.set_reveal_child(zoom > 1.0);
+
+        if zoom <= 1.0 {
+            return;
+        }
+
+        let source = glib::timeout_add_seconds_local_once(
+            2,
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                move || {
+                    let imp = obj.imp();
+                    imp.zoom_source.replace(None);
+                    imp.zoom_revealer.set_reveal_child(false);
+                }
+            ),
+        );
+        imp.zoom_source.replace(Some(source));
+    }
+
     fn show_recording_label(&self) {
         let imp = self.imp();
 
