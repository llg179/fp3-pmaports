--- a/src/widgets/camera.rs
+++ b/src/widgets/camera.rs
@@ -34,6 +34,7 @@ mod imp {
 
         pub recording_duration: Cell<u32>,
         pub recording_source: RefCell<Option<glib::source::SourceId>>,
