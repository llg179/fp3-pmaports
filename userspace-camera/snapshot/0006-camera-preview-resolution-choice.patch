+
+    /// The sizes this camera offers, largest first.
+    pub fn resolutions(&self) -> Vec<crate::utils::Size> {
+        self.imp().resolutions.borrow().clone()
+    }
+
+    /// Puts the viewfinder on the chosen size, or goes looking for one.
+    fn apply_preview_resolution(&self) {
+        let imp = self.imp();
+
+        if imp.resolutions.borrow().is_empty() {
+            return;
+        }
+
+        self.stop_probe();
+
+        let wanted = crate::utils::Size::parse(&self.preview_resolution());
+        let index = wanted.and_then(|size| {
+            imp.resolutions
+                .borrow()
+                .iter()
+                .position(|offered| *offered == size)
+        });
+
+        match index {
+            Some(index) => {
+                log::info!("Preview at {}", self.preview_resolution());
+                imp.frame_count.store(0, std::sync::atomic::Ordering::Relaxed);
+                self.switch_source_resolution(index);
+                self.verify_chosen_resolution();
+            }
+            None => self.start_probe(),
+        }
+    }
+
+    /// A size that was chosen rather than found still has to deliver.
+    ///
+    /// The one stored may have come from an older version, another camera, or
+    /// a person picking from the menu, and a size this camera cannot deliver
+    /// produces no error at all - just a black rectangle. Check that pictures
+    /// arrive, and go looking for a size if they do not.
+    fn verify_chosen_resolution(&self) {
+        let source = glib::timeout_add_seconds_local_once(
+            Self::PROBE_SECONDS,
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                move || {
+                    let imp = obj.imp();
+                    imp.probe_timeout.take();
+
+                    if imp.frame_count.load(std::sync::atomic::Ordering::Relaxed) > 0 {
+                        return;
+                    }
+
+                    log::warn!(
+                        "Nothing arrives at {}; looking for a size that works",
+                        obj.preview_resolution()
+                    );
+                    imp.preview_resolution.replace(String::new());
+                    obj.notify_preview_resolution();
+                    obj.start_probe();
+                }
+            ),
+        );
+
+        self.imp().probe_timeout.replace(Some(source));
+    }
+
+    /// Looks for the smallest size that actually streams.
+    ///
+    /// A camera advertises sizes it cannot always deliver: asked for one of
+    /// those, the pipeline answers 'Failed to start streaming: Resource busy'
+    /// and the viewfinder is simply dead. Which sizes those are is a property
+    /// of the camera and its driver, not something an application can know, so
+    /// the only honest way to find out is to ask for one and see.
+    ///
+    /// The search is a bisection rather than a walk. A camera can offer dozens
+    /// of sizes - one measured here offers 47 - and trying them one by one
+    /// costs a pipeline restart each, in front of a user looking at a black
+    /// screen. Bisecting the list, which is ordered by pixel count, finds the
+    /// boundary in about six attempts instead of thirty.
+    ///
+    /// What the bisection assumes is that a size which streams stays streaming
+    /// as it grows. Where that does not hold the result is merely not the
+    /// smallest one that works - never a size that does not, since only a size
+    /// seen to stream is ever settled on.
+    fn start_probe(&self) {
+        let imp = self.imp();
+        let last = imp.resolutions.borrow().len().saturating_sub(1);
+
+        // Index 0 is the largest, and the sensor's own mode: the likeliest to
+        // work, so it is where the search falls back to rather than starts.
+        imp.probe_lo.set(0);
+        imp.probe_hi.set(last);
+        imp.probe_found.set(false);
+        self.probe_step();
+    }
+
+    /// Tries the size in the middle of what is still unknown, or stops.
+    fn probe_step(&self) {
+        let imp = self.imp();
+
+        let lo = imp.probe_lo.get();
+        let hi = imp.probe_hi.get();
+
+        if lo >= hi {
+            if imp.probe_found.get() || lo == 0 {
+                self.probe_settle(lo);
+            } else {
+                // Nothing was ever seen to stream; the largest is untried.
+                self.try_probe(0);
+            }
+            return;
+        }
+
+        self.try_probe(lo + (hi - lo).div_ceil(2));
+    }
+
+    fn try_probe(&self, index: usize) {
+        let imp = self.imp();
+
+        let Some(size) = imp.resolutions.borrow().get(index).copied() else {
+            return;
+        };
+
+        log::info!("Trying {size} for the preview");
+        imp.probe.set(Some(index));
+        imp.frame_count.store(0, std::sync::atomic::Ordering::Relaxed);
+        self.switch_source_resolution(index);
+
+        // No error within the settling time means this size works.
+        let source = glib::timeout_add_seconds_local_once(
+            Self::PROBE_SECONDS,
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                move || obj.probe_succeeded()
+            ),
+        );
+        imp.probe_timeout.replace(Some(source));
+    }
+
+    /// The size being tried has streamed: smaller ones are still worth trying.
+    /// The settling time is up: decide by whether pictures actually arrived.
+    ///
+    /// Not erroring is not the same as working. A size this camera cannot
+    /// deliver fails loudly through libcamera - 'Resource busy' - but quietly
+    /// through PipeWire: the pipeline starts, reports nothing, and shows a
+    /// black rectangle for ever. Measured on a Fairphone 3, where the search
+    /// settled on 1024x600 on that evidence and the viewfinder stayed dark.
+    /// So the test is buffers at the video sink, which is the only thing that
+    /// distinguishes a working size from a silent one.
+    fn probe_succeeded(&self) {
+        let imp = self.imp();
+        imp.probe_timeout.take();
+
+        let Some(index) = imp.probe.take() else {
+            return;
+        };
+
+        let frames = imp.frame_count.load(std::sync::atomic::Ordering::Relaxed);
+        if frames == 0 {
+            log::info!("Nothing arrived at that size; trying a larger one");
+            imp.probe.set(Some(index));
+            self.probe_failed();
+            return;
+        }
+
+        log::debug!("{frames} frames arrived while trying that size");
+        imp.probe_lo.set(index);
+        imp.probe_found.set(true);
+
+        if index >= imp.probe_hi.get() {
+            self.probe_settle(index);
+        } else {
+            self.probe_step();
+        }
+    }
+
+    /// Called when the pipeline fails while a size is being tried: that size
+    /// and everything smaller is out.
+    fn probe_failed(&self) -> bool {
+        let imp = self.imp();
+
+        let Some(index) = imp.probe.take() else {
+            return false;
+        };
+
+        if let Some(source) = imp.probe_timeout.take() {
+            source.remove();
+        }
+
+        if index == 0 {
+            log::warn!("No size the camera offers would stream");
+            return false;
+        }
+
+        imp.probe_hi.set(index - 1);
+        self.probe_step();
+        true
+    }
+
+    fn probe_settle(&self, index: usize) {
+        let imp = self.imp();
+
+        let Some(size) = imp.resolutions.borrow().get(index).copied() else {
+            return;
+        };
+
+        log::info!("Preview settled at {size}");
+        self.switch_source_resolution(index);
+        imp.preview_resolution.replace(size.to_string());
+        self.notify_preview_resolution();
+    }
+
+    fn stop_probe(&self) {
+        let imp = self.imp();
+        imp.probe.set(None);
+        if let Some(source) = imp.probe_timeout.take() {
+            source.remove();
+        }
     }
 
     /// Whether the camera focuses continuously, or only when asked.
