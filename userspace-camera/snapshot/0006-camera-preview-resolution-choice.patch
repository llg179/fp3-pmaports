     }
 }
 
+/// A row for choosing what size the viewfinder runs at.
+///
+/// The list is what this camera offers, plus an entry for letting the
+/// application decide. Choosing a size the camera cannot actually stream is
+/// not fatal: the viewfinder answers by looking for one that works, and writes
+/// that back.
+pub fn resolution_row(
+    resolutions: &[aperture::utils::Size],
+    settings: &gio::Settings,
+) -> Option<adw::ComboRow> {
+    if resolutions.is_empty() {
+        return None;
+    }
+
+    let automatic = gettext("Automatic");
+    let mut labels = vec![automatic.clone()];
+    labels.extend(resolutions.iter().map(|size| {
+        /* A multiplication sign reads better than an x between numbers. */
+        format!("{}\u{00d7}{}", size.width, size.height)
+    }));
+
+    let model = gtk::StringList::new(&labels.iter().map(String::as_str).collect::<Vec<_>>());
+
+    let row = adw::ComboRow::new();
+    row.set_title(&gettext("Viewfinder Resolution"));
+    row.set_subtitle(&gettext("Smaller is faster; the picture is taken at full size either way"));
+    row.set_model(Some(&model));
+
+    let stored = settings.string("preview-resolution");
+    let selected = aperture::utils::Size::parse(&stored)
+        .and_then(|size| resolutions.iter().position(|offered| *offered == size))
+        .map(|index| index + 1)
+        .unwrap_or(0);
+    row.set_selected(selected as u32);
+
+    row.connect_selected_notify({
+        let settings = settings.clone();
+        let resolutions = resolutions.to_vec();
+        move |row| {
+            let value = match row.selected() {
+                0 => String::new(),
+                index => match resolutions.get(index as usize - 1) {
+                    Some(size) => size.to_string(),
+                    None => return,
+                },
+            };
+
+            if let Err(err) = settings.set_string("preview-resolution", &value) {
+                log::warn!("Could not store the viewfinder resolution: {err}");
+            }
+        }
+    });
+
+    Some(row)
+}
