+    /// Whether the camera focuses continuously, or only when asked.
+    ///
+    /// Off does not mean fixed focus: it means the camera stops hunting on its
+    /// own, and [`fn@Viewfinder::trigger_autofocus`] focuses once.
+    pub fn set_autofocus(&self, enabled: bool) {
+        self.imp().autofocus.set(enabled);
+
+        self.request_autofocus(if enabled {
+            crate::camera_control::AfRequest::Continuous
+        } else {
+            crate::camera_control::AfRequest::OnDemand
+        });
+    }
+
+    pub fn autofocus(&self) -> bool {
+        self.imp().autofocus.get()
+    }
+
+    /// Focuses once, now.
+    pub fn trigger_autofocus(&self) {
+        self.request_autofocus(crate::camera_control::AfRequest::Trigger);
+    }
+
+    fn request_autofocus(&self, request: crate::camera_control::AfRequest) {
+        let Some(camera) = self.camera() else {
+            return;
+        };
+
+        let Some(node_id) = camera.node_id() else {
+            log::debug!("Camera has no PipeWire node; leaving autofocus alone");
+            return;
+        };
+
+        crate::camera_control::request_autofocus(node_id, request);
+    }
+
     fn size_caps(size: crate::utils::Size) -> gst::Caps {
         crate::SUPPORTED_ENCODINGS
             .iter()
