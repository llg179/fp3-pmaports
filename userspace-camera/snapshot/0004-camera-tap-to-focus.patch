diff --git a/aperture/src/camera_control.rs b/aperture/src/camera_control.rs
new file mode 100644
index 0000000..1cdef9d
--- /dev/null
+++ b/aperture/src/camera_control.rs
@@ -0,0 +1,171 @@
+//! Setting libcamera controls on a PipeWire camera node.
+//!
+//! GStreamer's `pipewiresrc` has no way to reach a camera's controls: it
+//! exposes the stream, and nothing else. PipeWire's libcamera plugin does
+//! publish them, as node properties keyed by `SPA_PROP_START_CUSTOM` plus the
+//! libcamera control id, so they can be set on the node itself the way
+//! `pw-cli set-param <node> Props { ... }` does.
+//!
+//! Only integer controls arrive that way. The plugin maps `bool`, `int32` and
+//! `float` and returns early for arrays, so `AfMode` and `AfTrigger` come
+//! through while `AfWindows` does not.
+
+use std::cell::Cell;
+use std::cell::RefCell;
+use std::io::Cursor;
+use std::rc::Rc;
+
+use pipewire as pw;
+use pw::spa;
+
+/// First property id the libcamera plugin uses for a control it has no
+/// standard SPA property for.
+const SPA_PROP_START_CUSTOM: u32 = 0x1000000;
+
+/// libcamera control ids, from `control_ids.h`.
+const CONTROL_AF_MODE: u32 = 33;
+const CONTROL_AF_TRIGGER: u32 = 38;
+
+/// `AfMode` values, from libcamera's `control_ids_core.yaml`.
+const AF_MODE_AUTO: i32 = 1;
+const AF_MODE_CONTINUOUS: i32 = 2;
+
+/// `AfTrigger` values.
+const AF_TRIGGER_START: i32 = 0;
+
+/// What to do with a camera's autofocus.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum AfRequest {
+    /// Focus continuously, without being asked.
+    Continuous,
+    /// Only focus when triggered.
+    OnDemand,
+    /// Focus once, now.
+    Trigger,
+}
+
+impl AfRequest {
+    fn properties(self) -> Vec<(u32, i32)> {
+        match self {
+            Self::Continuous => vec![(CONTROL_AF_MODE, AF_MODE_CONTINUOUS)],
+            Self::OnDemand => vec![(CONTROL_AF_MODE, AF_MODE_AUTO)],
+            Self::Trigger => vec![
+                (CONTROL_AF_MODE, AF_MODE_AUTO),
+                (CONTROL_AF_TRIGGER, AF_TRIGGER_START),
+            ],
+        }
+    }
+}
+
+/// Applies an autofocus request to a camera node, without blocking the caller.
+///
+/// Talking to PipeWire means running a main loop until the server has answered,
+/// so it happens on a thread of its own. Failures are logged rather than
+/// returned: nothing the user can do about them, and a camera that will not
+/// focus on demand is still a working camera.
+pub fn request_autofocus(node_id: u32, request: AfRequest) {
+    std::thread::spawn(move || {
+        if let Err(err) = apply(node_id, request) {
+            log::warn!("Could not set autofocus on node {node_id}: {err}");
+        }
+    });
+}
+
+fn apply(node_id: u32, request: AfRequest) -> Result<(), pw::Error> {
+    pw::init();
+
+    let mainloop = pw::main_loop::MainLoopRc::new(None)?;
+    let context = pw::context::ContextRc::new(&mainloop, None)?;
+    let core = context.connect_rc(None)?;
+    let registry = Rc::new(core.get_registry_rc()?);
+
+    let node: Rc<RefCell<Option<pw::node::Node>>> = Rc::new(RefCell::new(None));
+
+    let _registry_listener = registry
+        .add_listener_local()
+        .global({
+            let node = node.clone();
+            let registry = registry.clone();
+            move |global| {
+                if global.id != node_id {
+                    return;
+                }
+
+                match registry.bind::<pw::node::Node, _>(global) {
+                    Ok(bound) => *node.borrow_mut() = Some(bound),
+                    Err(err) => log::warn!("Could not bind node {node_id}: {err}"),
+                }
+            }
+        })
+        .register();
+
+    // Run until the server has told us about every object it has.
+    roundtrip(&core, &mainloop)?;
+
+
+    let node = node.borrow();
+    let Some(node) = node.as_ref() else {
+        log::warn!("PipeWire node {node_id} not found");
+        return Ok(());
+    };
+
+    for (control, value) in request.properties() {
+        let key = SPA_PROP_START_CUSTOM + control;
+
+        let object = spa::pod::Value::Object(spa::pod::Object {
+            type_: spa::utils::SpaTypes::ObjectParamProps.as_raw(),
+            id: spa::param::ParamType::Props.as_raw(),
+            properties: vec![spa::pod::Property {
+                key,
+                flags: spa::pod::PropertyFlags::empty(),
+                value: spa::pod::Value::Int(value),
+            }],
+        });
+
+        let bytes = spa::pod::serialize::PodSerializer::serialize(Cursor::new(Vec::new()), &object)
+            .map(|(cursor, _)| cursor.into_inner())
+            .unwrap_or_default();
+
+        let Some(pod) = spa::pod::Pod::from_bytes(&bytes) else {
+            log::warn!("Could not build a Props pod for control {control}");
+            continue;
+        };
+
+        node.set_param(spa::param::ParamType::Props, 0, pod);
+        log::debug!("Set camera control {control} to {value} on node {node_id}");
+    }
+
+    // Make sure the messages leave before the loop is torn down.
+    roundtrip(&core, &mainloop)?;
+
+    Ok(())
+}
+
+/// Waits for the server to finish what it has been asked so far.
+fn roundtrip(
+    core: &pw::core::CoreRc,
+    mainloop: &pw::main_loop::MainLoopRc,
+) -> Result<(), pw::Error> {
+    let done = Rc::new(Cell::new(false));
+    let pending = core.sync(0)?;
+
+    let _listener = core
+        .add_listener_local()
+        .done({
+            let done = done.clone();
+            let mainloop = mainloop.clone();
+            move |id, seq| {
+                if id == pw::core::PW_ID_CORE && seq == pending {
+                    done.set(true);
+                    mainloop.quit();
+                }
+            }
+        })
+        .register();
+
+    while !done.get() {
+        mainloop.run();
+    }
+
+    Ok(())
+}
