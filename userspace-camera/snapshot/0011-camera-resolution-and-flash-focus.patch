+        let geometry = monitor.geometry();
+        // geometry() is in logical pixels; on a scaled display the panel has
+        // more than that, and it is the panel this is being compared against.
+        let scale = monitor.scale_factor().max(1) as i64;
+        let width = geometry.width() as i64 * scale;
+        let height = geometry.height() as i64 * scale;
+        if width <= 0 || height <= 0 {
+            return None;
