+/// A row for choosing what size a photograph is taken at.
+///
+/// Separate from the viewfinder's size on purpose: the two answer different
+/// questions. A small preview is about how much work the phone does to show
+/// you the scene, and a small photo is about the file you keep.
+pub fn photo_resolution_row(
+    resolutions: &[aperture::utils::Size],
+    settings: &gio::Settings,
+) -> Option<adw::ComboRow> {
+    if resolutions.is_empty() {
+        return None;
+    }
+
+    let full = gettext("Full Size");
+    let mut labels = vec![full.clone()];
+    labels.extend(resolutions.iter().map(|size| {
+        format!(
+            "{}\u{00d7}{} ({})",
+            size.width,
+            size.height,
+            megapixels(size)
+        )
+    }));
+
+    let model = gtk::StringList::new(&labels.iter().map(String::as_str).collect::<Vec<_>>());
+
+    let row = adw::ComboRow::new();
+    row.set_title(&gettext("Photo Resolution"));
+    row.set_subtitle(&gettext("What a photograph is taken at, whatever the viewfinder shows"));
+    row.set_model(Some(&model));
+
+    let stored = settings.string("photo-resolution");
+    let selected = aperture::utils::Size::parse(&stored)
+        .and_then(|size| resolutions.iter().position(|offered| *offered == size))
+        .map(|index| index + 1)
+        .unwrap_or(0);
+    row.set_selected(selected as u32);
+
+    row.connect_selected_notify({
+        let settings = settings.clone();
+        let resolutions = resolutions.to_vec();
+        move |row| {
+            let value = match row.selected() {
+                0 => String::new(),
+                index => match resolutions.get(index as usize - 1) {
+                    Some(size) => size.to_string(),
+                    None => return,
+                },
+            };
+
+            if let Err(err) = settings.set_string("photo-resolution", &value) {
+                log::warn!("Could not store the photo resolution: {err}");
+            }
+        }
+    });
+
+    Some(row)
+}
+
+fn megapixels(size: &aperture::utils::Size) -> String {
+    let mp = (size.width as f64 * size.height as f64) / 1_000_000.0;
+    format!("{mp:.1} MP")
+}
+
+/// JPEG bytes per pixel at a given quality, for the size estimate below.
+///
+/// ☠️ This is an estimate and the row says so. What a JPEG actually costs
+/// depends on the picture - a wall and a tree at the same quality differ by
+/// several times - so no formula can be right. The curve here is the usual
+/// shape, anchored so that quality 85 lands near a quarter of a byte per pixel,
+/// which is where ordinary photographs sit. It is meant to answer "roughly how
+/// much does moving this slider cost me", not to predict a file.
+fn bytes_per_pixel(quality: u32) -> f64 {
+    let q = quality as f64 / 100.0;
+    0.06 + 0.9 * q.powi(4)
+}
+
+/// A row for the JPEG quality, showing what it costs.
+pub fn jpeg_quality_row(
+    resolutions: &[aperture::utils::Size],
+    settings: &gio::Settings,
+) -> adw::SpinRow {
+    let row = adw::SpinRow::with_range(1.0, 100.0, 1.0);
+    row.set_title(&gettext("JPEG Quality"));
+    row.set_value(settings.uint("jpeg-quality") as f64);
+
+    // The size shown is for the size photographs are actually taken at, which
+    // is the stored photo resolution, or the largest the camera offers.
+    let stored = settings.string("photo-resolution");
+    let size = aperture::utils::Size::parse(&stored)
+        .filter(|size| resolutions.contains(size))
+        .or_else(|| resolutions.first().copied());
+
+    // Takes the row as an argument rather than capturing it: a closure that
+    // holds the widget it is connected to keeps that widget alive for ever.
+    fn show_estimate(row: &adw::SpinRow, size: Option<aperture::utils::Size>, quality: u32) {
+        let text = match size {
+            Some(size) => {
+                let pixels = size.width as f64 * size.height as f64;
+                let bytes = pixels * bytes_per_pixel(quality);
+                // Translators: an estimated file size, e.g. "About 2.4 MB per picture".
+                gettext("About {} per picture, give or take")
+                    .replace("{}", &glib::format_size(bytes as u64))
+            }
+            None => String::new(),
+        };
+        row.set_subtitle(&text);
+    }
+
+    show_estimate(&row, size, settings.uint("jpeg-quality"));
+
+    row.connect_value_notify({
+        let settings = settings.clone();
+        move |row| {
+            let quality = row.value().round() as u32;
+            show_estimate(row, size, quality);
+            if let Err(err) = settings.set_uint("jpeg-quality", quality) {
+                log::warn!("Could not store the JPEG quality: {err}");
+            }
+        }
+    });
+
+    row
+}
+
+/// A row that measures the camera and picks the viewfinder size for you.
+///
