+    /// cheap and happens while the viewfinder keeps running: the image branch
+    /// is not built until a capture starts.
+    fn apply_jpeg_quality(&self) {
+        if self.imp().camerabin.get().is_some() {
+            self.setup_recording();
+        }
+    }
