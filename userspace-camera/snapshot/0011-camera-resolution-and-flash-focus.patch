+/// action, and it writes its answer into the setting above.
+pub fn measure_resolution_row(run: impl Fn() + 'static) -> adw::ActionRow {
+    let row = adw::ActionRow::new();
+    row.set_title(&gettext("Find Best Size"));
+    row.set_subtitle(&gettext("Try sizes on this camera and keep the largest smooth one"));
+    row.set_activatable(true);
+
+    let icon = gtk::Image::from_icon_name("view-refresh-symbolic");
+    icon.add_css_class("dimmed");
+    row.add_suffix(&icon);
+
+    row.connect_activated(move |_| run());
+    row
+}
