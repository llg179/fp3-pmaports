+    /// Points captures at the chosen size, or at the largest one.
+    ///
+    /// Nothing about the running pipeline changes here. The index is only read
+    /// when the shutter runs, which is where the source is switched over and
+    /// back, so a photo size can be changed while the viewfinder keeps running.
+    fn apply_photo_resolution(&self) {
+        let imp = self.imp();
+
+        if imp.resolutions.borrow().is_empty() {
+            return;
+        }
+
+        let index = crate::utils::Size::parse(&self.photo_resolution()).and_then(|size| {
+            imp.resolutions
+                .borrow()
+                .iter()
+                .position(|offered| *offered == size)
+        });
+
+        // Index 0 is the largest the camera offers, and the default: an empty
+        // or unrecognised setting means full size, never a smaller guess.
+        let index = index.unwrap_or(0);
+        log::info!("Photographs at {}", imp.resolutions.borrow()[index]);
+        imp.capture_res.set(index);
+    }
+
