+    /// Chooses the resolution the preview runs at, and the one a photo is
+    /// taken at.
+    ///
+    /// These cannot be the same on a phone: the sensor's full resolution is
+    /// worth having in a picture and far too slow to preview. The approach is
+    /// Megapixels', which defines a preview mode and a capture mode per device
+    /// and switches between them for the shot - "usually the maximum
+    /// resolution of the sensor will be used for taking pictures but at that
+    /// resolution the framerate will generally be too low for realtime
+    /// preview", and it picks "the resolution closest to the display
+    /// resolution as the preview mode".
+    /// <https://libmegapixels-12f3eb.pages.debian.net/config.html>
+    ///
+    /// The switch has to happen on the source rather than on camerabin's
+    /// image-capture-caps: with a PipeWire source the pipeline cannot
+    /// renegotiate while it runs, and asking it to produces
+    /// `streaming stopped, reason not-negotiated` and a frozen viewfinder.
+    fn setup_capture_sizes(&self, camera: &crate::Camera) {
+        let imp = self.imp();
+
+        let resolutions = camera.resolutions();
+        if resolutions.is_empty() {
+            log::warn!("Camera reports no resolutions; leaving capture sizes alone");
+            return;
+        }
+
+        let preview = resolutions
+            .iter()
+            .position(|s| (s.width as i64) * (s.height as i64) <= Self::MAX_VIEWFINDER_PIXELS)
+            .unwrap_or(0);
+
+        log::info!(
+            "Capture at {}x{}, preview at {}x{}",
+            resolutions[0].width,
+            resolutions[0].height,
+            resolutions[preview].width,
+            resolutions[preview].height
+        );
+
+        imp.resolutions.replace(resolutions);
+        imp.capture_res.set(0);
+        imp.restore_res.set(None);
+        imp.slow_windows.set(0);
+        self.apply_source_resolution(preview);
+    }
+
+    fn size_caps(size: crate::utils::Size) -> gst::Caps {
+        crate::SUPPORTED_ENCODINGS
+            .iter()
+            .map(|encoding| {
+                gst::Caps::builder(*encoding)
+                    .field("width", size.width)
+                    .field("height", size.height)
+                    .build()
+            })
+            .collect::<gst::Caps>()
+    }
+
+    /// Constrains the source to one resolution. Does not restart anything.
+    fn apply_source_resolution(&self, index: usize) {
+        let imp = self.imp();
+
+        let size = {
+            let resolutions = imp.resolutions.borrow();
+            match resolutions.get(index).copied() {
+                Some(size) => size,
+                None => return,
+            }
+        };
+
+        imp.viewfinder_res.set(index);
+
+        if let Some(capsfilter) = imp.capsfilter.get() {
+            capsfilter.set_property("caps", &Self::size_caps(size));
+            log::debug!("Source constrained to {}x{}", size.width, size.height);
+        }
+    }
+
+    /// Switches the source to another resolution and restarts the pipeline.
+    fn switch_source_resolution(&self, index: usize) {
+        if self.imp().viewfinder_res.get() == index {
+            return;
+        }
+
+        self.apply_source_resolution(index);
+        self.reset_pipeline();
+    }
+
+    /// Drops the preview to the next smaller resolution, if there is one worth
+    /// dropping to. Returns whether anything changed.
+    fn lower_preview_resolution(&self) -> bool {
+        let imp = self.imp();
+        let next = imp.viewfinder_res.get() + 1;
+
+        let size = {
+            let resolutions = imp.resolutions.borrow();
+            match resolutions.get(next).copied() {
+                Some(size) => size,
+                None => return false,
+            }
+        };
+
+        if (size.width as i64) * (size.height as i64) < Self::MIN_VIEWFINDER_PIXELS {
+            return false;
+        }
+
+        self.switch_source_resolution(next);
+        true
+    }
+
+    /// Watches how fast frames actually arrive, and gives up resolution when
+    /// they do not.
+    fn start_fps_monitor(&self) {
+        let imp = self.imp();
+
+        if imp.fps_source.borrow().is_some() {
+            return;
+        }
+
+        imp.frame_count.store(0, std::sync::atomic::Ordering::Relaxed);
+
+        let source = glib::timeout_add_seconds_local(
+            Self::FPS_WINDOW,
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                #[upgrade_or]
+                glib::ControlFlow::Break,
+                move || {
+                    obj.check_fps();
+                    glib::ControlFlow::Continue
+                }
+            ),
+        );
+
+        imp.fps_source.replace(Some(source));
+    }
+
+    fn stop_fps_monitor(&self) {
+        if let Some(source) = self.imp().fps_source.take() {
+            source.remove();
+        }
+    }
+
+    fn check_fps(&self) {
+        let imp = self.imp();
+
+        let frames = imp
+            .frame_count
+            .swap(0, std::sync::atomic::Ordering::Relaxed);
+        let fps = f64::from(frames) / f64::from(Self::FPS_WINDOW);
+
+        // A stream that has just started, one that is not running, or one in
+        // the middle of taking a picture says nothing about how fast the
+        // pipeline can go.
+        if !matches!(self.state(), ViewfinderState::Ready)
+            || frames == 0
+            || imp.restore_res.get().is_some()
+            || imp.is_taking_picture.get()
+        {
+            imp.slow_windows.set(0);
+            return;
+        }
+
+        if fps >= Self::SLOW_FPS {
+            imp.slow_windows.set(0);
+            return;
+        }
+
+        let slow = imp.slow_windows.get() + 1;
+        imp.slow_windows.set(slow);
+        log::debug!("Viewfinder at {fps:.1} fps ({slow} slow windows)");
+
+        if slow < Self::SLOW_WINDOWS {
+            return;
+        }
+
+        imp.slow_windows.set(0);
+
+        if self.lower_preview_resolution() {
+            log::info!("Only {fps:.1} fps; lowering the preview resolution");
+        }
+    }
+
