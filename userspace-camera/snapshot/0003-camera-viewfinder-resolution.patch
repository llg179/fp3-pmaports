+    /// Pins still capture to the sensor's largest resolution, and starts the
+    /// viewfinder at one small enough to be smooth.
+    ///
+    /// The two are deliberately separate. The source's capsfilter is shared by
+    /// both paths, so without an explicit `image-capture-caps` a smaller
+    /// viewfinder would quietly shrink the saved picture as well.
+    fn setup_capture_sizes(&self, camera: &crate::Camera) {
+        let imp = self.imp();
+
+        let resolutions = camera.resolutions();
+        if resolutions.is_empty() {
+            log::warn!("Camera reports no resolutions; leaving capture sizes alone");
+            return;
+        }
+
+        let largest = resolutions[0];
+        imp.camerabin()
+            .set_property("image-capture-caps", &Self::size_caps(largest));
+        log::info!(
+            "Still capture pinned to {}x{}",
+            largest.width,
+            largest.height
+        );
+
+        // Start at the largest resolution that is not obviously too much to
+        // debayer and paint in software: the viewfinder only has to fill a
+        // phone screen.
+        let start = resolutions
+            .iter()
+            .position(|s| (s.width as i64) * (s.height as i64) <= Self::MAX_VIEWFINDER_PIXELS)
+            .unwrap_or(resolutions.len() - 1);
+
+        imp.resolutions.replace(resolutions);
+        imp.slow_windows.set(0);
+        self.set_viewfinder_resolution(start);
+    }
+
+    fn size_caps(size: crate::utils::Size) -> gst::Caps {
+        gst::Caps::builder("video/x-raw")
+            .field("width", size.width)
+            .field("height", size.height)
+            .build()
+    }
+
+    fn set_viewfinder_resolution(&self, index: usize) {
+        let imp = self.imp();
+        let resolutions = imp.resolutions.borrow();
+
+        let Some(size) = resolutions.get(index).copied() else {
+            return;
+        };
+        drop(resolutions);
+
+        imp.viewfinder_res.set(index);
+        imp.camerabin()
+            .set_property("viewfinder-caps", &Self::size_caps(size));
+        log::info!("Viewfinder at {}x{}", size.width, size.height);
+    }
+
+    /// Drops the viewfinder to the next smaller resolution, if there is one
+    /// worth dropping to. Returns whether anything changed.
+    fn lower_viewfinder_resolution(&self) -> bool {
+        let imp = self.imp();
+        let next = imp.viewfinder_res.get() + 1;
+
+        let size = {
+            let resolutions = imp.resolutions.borrow();
+            match resolutions.get(next).copied() {
+                Some(size) => size,
+                None => return false,
+            }
+        };
+
+        if (size.width as i64) * (size.height as i64) < Self::MIN_VIEWFINDER_PIXELS {
+            return false;
+        }
+
+        self.set_viewfinder_resolution(next);
+        true
+    }
+
+    /// Watches how fast frames actually arrive, and gives up resolution when
+    /// they do not.
+    fn start_fps_monitor(&self) {
+        let imp = self.imp();
+
+        if imp.fps_source.borrow().is_some() {
+            return;
+        }
+
+        imp.frame_count.store(0, std::sync::atomic::Ordering::Relaxed);
+
+        let source = glib::timeout_add_seconds_local(
+            Self::FPS_WINDOW,
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                #[upgrade_or]
+                glib::ControlFlow::Break,
+                move || {
+                    obj.check_fps();
+                    glib::ControlFlow::Continue
+                }
+            ),
+        );
+
+        imp.fps_source.replace(Some(source));
+    }
+
+    fn stop_fps_monitor(&self) {
+        if let Some(source) = self.imp().fps_source.take() {
+            source.remove();
+        }
+    }
+
+    fn check_fps(&self) {
+        let imp = self.imp();
+
+        let frames = imp
+            .frame_count
+            .swap(0, std::sync::atomic::Ordering::Relaxed);
+        let fps = f64::from(frames) / f64::from(Self::FPS_WINDOW);
+
+        // A stream that has just started, or one that is not running at all,
+        // says nothing about how fast the pipeline can go.
+        if !matches!(self.state(), ViewfinderState::Ready) || frames == 0 {
+            imp.slow_windows.set(0);
+            return;
+        }
+
+        if fps >= Self::SLOW_FPS {
+            imp.slow_windows.set(0);
+            return;
+        }
+
+        let slow = imp.slow_windows.get() + 1;
+        imp.slow_windows.set(slow);
+        log::debug!("Viewfinder at {fps:.1} fps ({slow} slow windows)");
+
+        if slow < Self::SLOW_WINDOWS {
+            return;
+        }
+
+        imp.slow_windows.set(0);
+
+        if self.lower_viewfinder_resolution() {
+            log::info!("Only {fps:.1} fps; lowering the viewfinder resolution");
+            self.reset_pipeline();
+        }
+    }
+
     fn reset_pipeline(&self) {
         if matches!(
             self.imp().camerabin().current_state(),
