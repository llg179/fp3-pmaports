+    /// Largest viewfinder resolution to start from. A phone screen is far
+    /// smaller than the sensor, and every pixel above this is debayered in
+    /// software for nothing.
+    const MAX_VIEWFINDER_PIXELS: i64 = 1920 * 1080;
+    /// Never drop the viewfinder below this.
+    const MIN_VIEWFINDER_PIXELS: i64 = 640 * 480;
+    /// Frames per second below which the viewfinder is too slow to use.
+    const SLOW_FPS: f64 = 20.0;
+    /// Consecutive slow windows before giving up a resolution step.
+    const SLOW_WINDOWS: u32 = 2;
+    /// Length of one measurement window, in seconds.
+    const FPS_WINDOW: u32 = 2;
+    /// How many 100 ms waits to allow the pipeline for coming back up after
+    /// switching resolution for a picture.
+    const CAPTURE_WAIT_TRIES: u32 = 50;
