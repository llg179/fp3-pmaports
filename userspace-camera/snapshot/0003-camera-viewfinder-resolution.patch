--- a/aperture/src/camera.rs
+++ b/aperture/src/camera.rs
@@ -159,4 +159,27 @@ impl Camera {
 
         highest_res_caps
     }
+
+    /// Every raw resolution the camera offers, largest first.
+    ///
+    /// Used to pick a viewfinder size, and to pin still capture to the
+    /// largest size the sensor has.
+    pub(crate) fn resolutions(&self) -> Vec<crate::utils::Size> {
+        let Some(caps) = self.caps() else {
+            return Vec::new();
+        };
+
+        let mut sizes: Vec<crate::utils::Size> = caps
+            .iter()
+            .filter_map(|s| {
+                let width = s.get::<i32>("width").ok()?;
+                let height = s.get::<i32>("height").ok()?;
+                Some(crate::utils::Size { width, height })
+            })
+            .collect();
+
+        sizes.sort_by_key(|s| std::cmp::Reverse(s.width as i64 * s.height as i64));
+        sizes.dedup_by(|a, b| a.width == b.width && a.height == b.height);
+        sizes
+    }
 }
