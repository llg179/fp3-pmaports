+    /// Waits for the pipeline to come back up after a resolution switch, then
+    /// takes the picture.
+    ///
+    /// If it does not come back up, the shot is taken anyway: a picture at the
+    /// wrong resolution beats a shutter press that does nothing.
+    async fn capture_when_running(&self) {
+        let camerabin = self.imp().camerabin().clone();
+
+        for _ in 0..Self::CAPTURE_WAIT_TRIES {
+            if camerabin.current_state() == gst::State::Playing {
+                break;
+            }
+
+            glib::timeout_future(std::time::Duration::from_millis(100)).await;
+        }
+
+        if camerabin.current_state() != gst::State::Playing {
+            log::warn!("Pipeline did not come back up before the capture");
+        }
+
+        camerabin.emit_by_name::<()>("start-capture", &[]);
+    }
