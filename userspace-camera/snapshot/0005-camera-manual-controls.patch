+/// What a camera control accepts.
+#[derive(Debug, Clone, PartialEq)]
+pub enum ControlKind {
+    /// A number anywhere between two bounds.
+    Range {
+        min: f64,
+        max: f64,
+        default: f64,
+        /// Whether it is a whole number, which decides how it is written out
+        integer: bool,
+    },
+    /// One of a fixed set of named values.
+    Choice {
+        values: Vec<(i32, String)>,
+        default: i32,
+    },
+    /// On or off.
+    Switch { default: bool },
+}
+
+/// A control the camera publishes, as PipeWire describes it.
+#[derive(Debug, Clone, PartialEq)]
+pub struct CameraControl {
+    /// The key `pw-cli` wants inside `Props`
+    pub key: String,
+    /// libcamera's name for it, e.g. `ExposureTime`
+    pub name: String,
+    pub kind: ControlKind,
+}
+
+impl CameraControl {
+    /// Whether this control is one of the four that decide whether another
+    /// control is listened to at all.
+    pub fn is_mode_for(&self) -> Option<&'static str> {
+        match self.name.as_str() {
+            "ExposureTimeMode" => Some("ExposureTime"),
+            "AnalogueGainMode" => Some("AnalogueGain"),
+            "AwbEnable" => Some("ColourTemperature"),
+            "AfMode" => Some("LensPosition"),
+            _ => None,
+        }
+    }
+
+    /// The value that hands this control back to the camera.
+    pub fn automatic_value(&self) -> Option<f64> {
+        match &self.kind {
+            /* AwbEnable is a plain switch: on means the camera decides. */
+            ControlKind::Switch { .. } => Some(1.0),
+            ControlKind::Choice { values, .. } => values
+                .iter()
+                /*
+                 * Continuous outranks Auto where both exist, which is only
+                 * AfMode: "Auto" there means one-shot on request, not by
+                 * itself.
+                 */
+                .find(|(_, name)| name.ends_with("Continuous"))
+                .or_else(|| values.iter().find(|(_, name)| name.ends_with("Auto")))
+                .map(|(value, _)| *value as f64),
+            ControlKind::Range { .. } => None,
+        }
+    }
+
+    /// The value that hands this control to the application.
+    pub fn manual_value(&self) -> Option<f64> {
+        match &self.kind {
+            ControlKind::Switch { .. } => Some(0.0),
+            ControlKind::Choice { values, .. } => values
+                .iter()
+                .find(|(_, name)| name.ends_with("Manual"))
+                .map(|(value, _)| *value as f64),
+            ControlKind::Range { .. } => None,
+        }
+    }
+}
+
+/// Asks PipeWire what the camera node offers.
+///
+/// The node describes itself: every control libcamera publishes is a property
+/// with a description, a type and its bounds, which is enough to build a user
+/// interface for a camera nobody wrote code for. Returns an empty list if the
+/// node cannot be read - a camera whose controls are unknown is still a camera.
+pub fn discover(node_id: u32) -> Vec<CameraControl> {
+    let output = Command::new("pw-dump")
+        .arg(node_id.to_string())
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output();
+
+    let output = match output {
+        Ok(output) if output.status.success() => output.stdout,
+        Ok(output) => {
+            log::warn!("pw-dump {node_id} failed: {}", output.status);
+            return Vec::new();
+        }
+        Err(err) => {
+            log::warn!("Could not run pw-dump: {err}");
+            return Vec::new();
+        }
+    };
+
+    let dump: serde_json::Value = match serde_json::from_slice(&output) {
+        Ok(dump) => dump,
+        Err(err) => {
+            log::warn!("Could not read what pw-dump said: {err}");
+            return Vec::new();
+        }
+    };
+
+    let Some(infos) = dump
+        .get(0)
+        .and_then(|node| node.pointer("/info/params/PropInfo"))
+        .and_then(|infos| infos.as_array())
+    else {
+        log::debug!("PipeWire node {node_id} publishes no controls");
+        return Vec::new();
+    };
+
+    infos.iter().filter_map(parse_control).collect()
+}
+
+fn parse_control(info: &serde_json::Value) -> Option<CameraControl> {
+    let id = info.get("id")?.as_str()?;
+    let name = info.get("description")?.as_str()?.to_owned();
+    let kind = info.get("type")?;
+
+    /*
+     * A control PipeWire has no name of its own for is reported as the hex of
+     * its property id, which is what it has to be set by. The rest keep their
+     * names both ways round.
+     */
+    let key = match id.strip_prefix("id-") {
+        Some(hex) => u32::from_str_radix(hex, 16).ok()?.to_string(),
+        None => id.to_owned(),
+    };
+
+    let default = kind.get("default")?;
+
+    let kind = if let Some(labels) = info.get("labels").and_then(|l| l.as_array()) {
+        /* [value, name, value, name, ...] */
+        let values = labels
+            .chunks_exact(2)
+            .filter_map(|pair| {
+                Some((
+                    pair[0].as_i64()? as i32,
+                    pair[1].as_str()?.to_owned(),
+                ))
+            })
+            .collect::<Vec<_>>();
+
+        if values.is_empty() {
+            return None;
+        }
+
+        ControlKind::Choice {
+            values,
+            default: default.as_i64()? as i32,
+        }
+    } else if let Some(default) = default.as_bool() {
+        ControlKind::Switch { default }
+    } else {
+        ControlKind::Range {
+            min: kind.get("min")?.as_f64()?,
+            max: kind.get("max")?.as_f64()?,
+            default: default.as_f64()?,
+            integer: default.is_i64() || default.is_u64(),
+        }
+    };
+
+    Some(CameraControl { key, name, kind })
+}
+
+/// Sets one control on a camera node, without blocking the caller.
+pub fn set_control(node_id: u32, control: &CameraControl, value: f64) {
+    let key = control.key.clone();
+    let literal = match &control.kind {
+        ControlKind::Switch { .. } => (value != 0.0).to_string(),
+        ControlKind::Choice { .. } => (value as i64).to_string(),
+        ControlKind::Range { integer: true, .. } => (value.round() as i64).to_string(),
+        ControlKind::Range { .. } => format!("{value}"),
+    };
+
+    std::thread::spawn(move || set_literal(node_id, &key, &literal));
+}
+
