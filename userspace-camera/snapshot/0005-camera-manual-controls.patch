diff --git a/src/widgets/camera_settings.rs b/src/widgets/camera_settings.rs
new file mode 100644
index 0000000..316daa1
--- /dev/null
+++ b/src/widgets/camera_settings.rs
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! The camera's own settings, as rows in the preferences.
+//!
+//! Nothing here knows what an exposure time is. The camera describes its
+//! controls - name, type, bounds - and each one becomes a row: a switch for
+//! those that choose between the camera deciding and the user deciding, and a
+//! number for everything else. A camera that publishes a control nobody
+//! anticipated still gets a working row, and one that publishes none adds no
+//! group at all.
+
+use std::collections::HashMap;
+
+use adw::prelude::*;
+use aperture::camera_control::{CameraControl, ControlKind};
+use gettextrs::gettext;
+use gtk::gio;
+
+/// What the user is shown instead of libcamera's name, where there is a better
+/// one. Anything missing here is shown under the name the camera gave.
+fn label_for(name: &str) -> Option<&'static str> {
+    Some(match name {
+        "ExposureTime" => "Exposure Time",
+        "AnalogueGain" => "Analogue Gain",
+        "ColourTemperature" => "Colour Temperature",
+        "LensPosition" => "Focus Distance",
+        _ => return None,
+    })
+}
+
+/// The unit, where naming it saves an explanation.
+fn unit_for(name: &str) -> Option<&'static str> {
+    Some(match name {
+        "ExposureTime" => "Microseconds",
+        "AnalogueGain" => "Multiplier",
+        "ColourTemperature" => "Kelvin",
+        "LensPosition" => "Dioptres, 0 is infinity",
+        _ => return None,
+    })
+}
+
+fn title_for(control: &CameraControl) -> String {
+    match label_for(&control.name) {
+        Some(label) => gettext(label),
+        None => control.name.clone(),
+    }
+}
+
+/// Builds the group, or nothing if the camera has nothing to offer.
+pub fn group(
+    controls: &[CameraControl],
+    settings: &gio::Settings,
+    apply: impl Fn(&CameraControl, f64) + Clone + 'static,
+) -> Option<adw::PreferencesGroup> {
+    if controls.is_empty() {
+        return None;
+    }
+
+    let group = adw::PreferencesGroup::new();
+    group.set_title(&gettext("Camera"));
+    group.set_description(Some(&gettext(
+        "What the camera decides for itself, and what you decide instead",
+    )));
+
+    let saved = stored(settings);
+    let mut rows = 0;
+
+    /*
+     * The paired controls first, each as a switch that reveals its value, so
+     * that the thing being taken over sits next to the taking over.
+     */
+    for control in controls {
+        let Some(paired) = control.is_mode_for() else {
+            continue;
+        };
+        let Some(value) = controls.iter().find(|c| c.name == paired) else {
+            /*
+             * A camera can offer the mode without the value - our own focus
+             * does, until the lens has been related to a distance. A switch
+             * that reveals nothing is worse than no switch.
+             */
+            continue;
+        };
+
+        let (Some(auto), Some(manual)) = (control.automatic_value(), control.manual_value()) else {
+            continue;
+        };
+
+        let is_auto = saved
+            .get(&control.name)
+            .map(|stored| (stored - manual).abs() > f64::EPSILON)
+            .unwrap_or(true);
+
+        let switch = adw::SwitchRow::new();
+        switch.set_title(&format!("{} — {}", gettext("Automatic"), title_for(value)));
+        switch.set_active(is_auto);
+
+        let row = value_row(value, saved.get(&value.name).copied());
+        row.set_visible(!is_auto);
+
+        switch.connect_active_notify({
+            let control = control.clone();
+            let settings = settings.clone();
+            let apply = apply.clone();
+            let row = row.clone();
+            move |switch| {
+                let chosen = if switch.is_active() { auto } else { manual };
+                row.set_visible(!switch.is_active());
+                remember(&settings, &control.name, chosen);
+                apply(&control, chosen);
+            }
+        });
+
+        row.connect_value_notify({
+            let value = value.clone();
+            let settings = settings.clone();
+            let apply = apply.clone();
+            move |row| {
+                remember(&settings, &value.name, row.value());
+                apply(&value, row.value());
+            }
+        });
+
+        group.add(&switch);
+        group.add(&row);
+        rows += 1;
+    }
+
+    /* Then everything that is simply a number the camera always listens to. */
+    let paired: Vec<&str> = controls
+        .iter()
+        .filter_map(CameraControl::is_mode_for)
+        .collect();
+
+    for control in controls {
+        if control.is_mode_for().is_some() || paired.contains(&control.name.as_str()) {
+            continue;
+        }
+        if !matches!(control.kind, ControlKind::Range { .. }) {
+            continue;
+        }
+
+        let row = value_row(control, saved.get(&control.name).copied());
+        row.connect_value_notify({
+            let control = control.clone();
+            let settings = settings.clone();
+            let apply = apply.clone();
+            move |row| {
+                remember(&settings, &control.name, row.value());
+                apply(&control, row.value());
+            }
+        });
+
+        group.add(&row);
+        rows += 1;
+    }
+
+    (rows > 0).then_some(group)
+}
+
+fn value_row(control: &CameraControl, saved: Option<f64>) -> adw::SpinRow {
+    let ControlKind::Range {
+        min,
+        max,
+        default,
+        integer,
+    } = control.kind
+    else {
+        return adw::SpinRow::new(None::<&gtk::Adjustment>, 0.0, 0);
+    };
+
+    /*
+     * A hundred steps across the range, rounded to something a person would
+     * choose: the exposure time spans four decades on this camera, and a step
+     * of one microsecond would be unusable.
+     */
+    let step = if integer {
+        ((max - min) / 100.0).round().max(1.0)
+    } else {
+        (max - min) / 100.0
+    };
+    let digits = if integer { 0 } else { 2 };
+
+    let adjustment = gtk::Adjustment::new(
+        saved.unwrap_or(default).clamp(min, max),
+        min,
+        max,
+        step,
+        step * 10.0,
+        0.0,
+    );
+
+    let row = adw::SpinRow::new(Some(&adjustment), step, digits);
+    row.set_title(&title_for(control));
+    if let Some(unit) = unit_for(&control.name) {
+        row.set_subtitle(&gettext(unit));
+    }
+    row
+}
+
+/// Everything the user has chosen so far, by control name.
+pub fn stored(settings: &gio::Settings) -> HashMap<String, f64> {
+    settings
+        .value("camera-controls")
+        .get::<HashMap<String, f64>>()
+        .unwrap_or_default()
+}
+
+fn remember(settings: &gio::Settings, name: &str, value: f64) {
+    let mut all = stored(settings);
+    all.insert(name.to_owned(), value);
+
+    if let Err(err) = settings.set_value("camera-controls", &all.to_variant()) {
+        log::warn!("Could not remember {name}: {err}");
+    }
+}
