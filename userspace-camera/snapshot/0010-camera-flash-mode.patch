+            glib::timeout_future(std::time::Duration::from_millis(600)).await;
+        }
+
+        if let Err(err) = imp.viewfinder.take_picture(path) {
+            self.set_flash_lit(false);
+            return Err(err.into());
+        }
         imp.flash_bin.flash();
 
