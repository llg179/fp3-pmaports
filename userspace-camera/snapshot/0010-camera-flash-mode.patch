diff --git a/src/flash.rs b/src/flash.rs
new file mode 100644
index 0000000..39d2cba
--- /dev/null
+++ b/src/flash.rs
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! The camera flash, as the kernel's LED flash class exposes it.
+//!
+//! Nothing here is specific to one phone: a flash LED is found by looking for
+//! the attributes the flash class defines rather than by name, and a device
+//! that has none simply reports no flash, which hides the button.
+//!
+//! Only the torch is used - `brightness` held on across the capture - and not
+//! `flash_strobe`. A strobe is a single timed pulse the kernel fires and the
+//! app cannot align with the moment the frame is actually read out, since the
+//! capture goes through PipeWire and GStreamer; a torch that is already lit
+//! when the shutter runs needs no such alignment.
+
+use std::path::{Path, PathBuf};
+
+const LEDS: &str = "/sys/class/leds";
+const IIO: &str = "/sys/bus/iio/devices";
+
+/// Below this many lux the scene counts as dark enough for the automatic mode
+/// to light the flash. Twilight is around 10 lux and a lit room 100-300, so
+/// this sits well inside "the lamps are off".
+const DARK_LUX: f64 = 12.0;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum FlashMode {
+    #[default]
+    Off,
+    Auto,
+    On,
+}
+
+impl FlashMode {
+    pub fn from_setting(value: &str) -> Self {
+        match value {
+            "auto" => Self::Auto,
+            "on" => Self::On,
+            _ => Self::Off,
+        }
+    }
+}
+
+/// A flash LED, found once and remembered.
+#[derive(Debug)]
+pub struct Flash {
+    path: PathBuf,
+    max_brightness: u32,
+}
+
+impl Flash {
+    /// The first LED that carries the flash class's own attributes.
+    ///
+    /// `flash_brightness` is what distinguishes a camera flash from the
+    /// notification LED next to it, and it is the kernel's marker rather than
+    /// a naming convention, so this does not need a list of devices.
+    pub fn find() -> Option<Self> {
+        let entries = std::fs::read_dir(LEDS).ok()?;
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if !path.join("flash_brightness").exists() {
+                continue;
+            }
+            let Some(max_brightness) = read_u32(&path.join("max_brightness")) else {
+                continue;
+            };
+            if max_brightness == 0 {
+                continue;
+            }
+            return Some(Self {
+                path,
+                max_brightness,
+            });
+        }
+        None
+    }
+
+    /// Whether the LED can actually be driven from here.
+    ///
+    /// Finding the LED is not the same as being allowed to write it: the
+    /// attribute belongs to root unless a udev rule hands it to the seat. The
+    /// button is only worth showing if a write would land.
+    pub fn is_writable(&self) -> bool {
+        std::fs::OpenOptions::new()
+            .write(true)
+            .open(self.path.join("brightness"))
+            .is_ok()
+    }
+
+    pub fn set_lit(&self, lit: bool) {
+        let value = if lit { self.max_brightness } else { 0 };
+        if let Err(err) = std::fs::write(self.path.join("brightness"), value.to_string()) {
+            log::warn!("Could not set the flash brightness: {err}");
+        }
+    }
+
+    /// Whether this mode wants the flash lit for the shot about to be taken.
+    pub fn wants_light(&self, mode: FlashMode) -> bool {
+        match mode {
+            FlashMode::Off => false,
+            FlashMode::On => true,
+            FlashMode::Auto => match ambient_lux() {
+                Some(lux) => lux < DARK_LUX,
+                // Without a light sensor the automatic mode has nothing to
+                // decide on, and firing a flash nobody asked for is the worse
+                // of the two mistakes.
+                None => false,
+            },
+        }
+    }
+}
+
+/// The ambient light, in lux, from whichever IIO device reports it.
+///
+/// ☠️ This measures the light falling on the *phone*, not on what the camera is
+/// pointed at - the sensor sits by the earpiece, facing the user. It is used
+/// here because it is the one brightness signal that is independent of the
+/// camera: the viewfinder's own brightness is held near mid-grey by automatic
+/// exposure, so reading it would measure the exposure loop rather than the
+/// scene. The signal that would actually describe the frame is the exposure
+/// time and gain the algorithm settled on, and libcamera does not publish
+/// those back through PipeWire.
+fn ambient_lux() -> Option<f64> {
+    let entries = std::fs::read_dir(IIO).ok()?;
+    for entry in entries.flatten() {
+        let file = entry.path().join("in_illuminance_input");
+        if let Some(value) = read_number(&file) {
+            return Some(value);
+        }
+    }
+    None
+}
+
+fn read_number(path: &Path) -> Option<f64> {
+    std::fs::read_to_string(path).ok()?.trim().parse().ok()
+}
+
+fn read_u32(path: &Path) -> Option<u32> {
+    std::fs::read_to_string(path).ok()?.trim().parse().ok()
+}
