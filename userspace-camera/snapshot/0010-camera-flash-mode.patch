     }
 
+    /// The flash mode the user has chosen, from the setting the menu drives.
+    fn flash_mode(&self) -> crate::flash::FlashMode {
+        crate::flash::FlashMode::from_setting(&self.imp().settings().string("flash-mode"))
+    }
+
+    /// Whether the flash should be lit for the picture about to be taken.
+    fn flash_wants_light(&self) -> bool {
+        match self.imp().flash.get() {
+            Some(Some(flash)) => flash.wants_light(self.flash_mode()),
+            _ => false,
+        }
+    }
+
+    fn set_flash_lit(&self, lit: bool) {
+        if let Some(Some(flash)) = self.imp().flash.get() {
+            flash.set_lit(lit);
+        }
+    }
+
+    /// Show the chosen mode on the button itself, so it does not take a menu
+    /// to find out whether the flash is about to fire.
+    pub fn update_flash_button(&self) {
+        let button = &self.imp().flash_button;
+        button.remove_css_class("accent");
+        button.remove_css_class("dimmed");
+        match self.flash_mode() {
+            crate::flash::FlashMode::Off => button.add_css_class("dimmed"),
+            crate::flash::FlashMode::On => button.add_css_class("accent"),
+            crate::flash::FlashMode::Auto => (),
+        }
+    }
+
     pub fn set_countdown(&self, countdown: u32) {
         self.imp().camera_controls.set_countdown(countdown);
     }
