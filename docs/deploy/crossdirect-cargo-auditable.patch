diff --git a/cross/crossdirect/cargo.sh b/cross/crossdirect/cargo.sh
index d29b40fc15..491cc737ad 100644
--- a/cross/crossdirect/cargo.sh
+++ b/cross/crossdirect/cargo.sh
@@ -16,13 +16,25 @@ triplet=$(/usr/bin/rustc -vV | sed -n 's/host: //p')
 cmd=$1
 shift
 
+# `cargo auditable build ...` is `cargo build ...` with the dependency list
+# embedded in the binary, so what decides whether this can be cross compiled is
+# the word after it, not the word itself. Without this the wrapper falls into
+# the unsupported branch below and the whole build runs under QEMU - which is
+# not a small difference: it is the whole Rust dependency tree, every time.
+wrapper=
+if [ "$cmd" = "auditable" ]; then
+	wrapper=$cmd
+	cmd=$1
+	shift
+fi
+
 case "$cmd" in
 	build|test|run)
 		;;
 	*)
-		echo "WARNING: crossdirect: 'cargo $cmd $*' command not supported, running in QEMU (slow!)" >&2
+		echo "WARNING: crossdirect: 'cargo $wrapper $cmd $*' command not supported, running in QEMU (slow!)" >&2
 		export PATH="$(echo "$PATH" | sed 's,/native/usr/lib/crossdirect/[^:]*:,,')"
-		exec /usr/bin/cargo "$cmd" "$@"
+		exec /usr/bin/cargo $wrapper "$cmd" "$@"
 		;;
 esac
 
@@ -51,10 +63,10 @@ if [ -z "$target_specified" ]; then
 fi
 
 if [ -n "$target_already_specified" ]; then
-	exec /usr/bin/cargo "$cmd" "$@"
+	exec /usr/bin/cargo $wrapper "$cmd" "$@"
 fi
 
-/usr/bin/cargo "$cmd" --target=$triplet "$@"
+/usr/bin/cargo $wrapper "$cmd" --target=$triplet "$@"
 
