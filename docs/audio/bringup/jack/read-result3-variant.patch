+	dev_info(component->dev, "DBG mbhc edge @%u ms: RESULT_3=0x%02x -> %s\n",
+		 jiffies_to_msecs(jiffies), res3, ins ? "IN" : "OUT");
+
 	if (ins) { /* hs insertion */
 		u32 btndet_curr_src;
 
