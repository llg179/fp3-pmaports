+	 */
+	res3 = snd_soc_component_read(component, WCD9335_ANA_MBHC_RESULT_3);
+	ins = !(res3 & BIT(3));
+	wcd->jack_inserted = ins;
 
-	/* Re-arm L_DET for the opposite edge (detect removal once inserted). */
