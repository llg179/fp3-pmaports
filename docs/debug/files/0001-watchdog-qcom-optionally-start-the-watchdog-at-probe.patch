From 7c34897f660ef2c171367091de78ae88979cb8dc Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lajosh=C3=A1zi=2C=20L=C3=A1szl=C3=B3=20Gergely?=
 <lajoshazilg@gmail.com>
Date: Thu, 30 Jul 2026 15:54:15 +0200
Subject: [PATCH] watchdog: qcom: optionally start the watchdog at probe
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

qcom_wdt only takes ownership of the hardware when the bootloader already
left it running: Robert Marko's 8650d0f9e933 sets WDOG_HW_RUNNING inside
if (qcom_wdt_is_running()) and does nothing otherwise. On a board whose
bootloader leaves the watchdog disabled, the watchdog core therefore never
pings anything and never arms the open deadline, so there is no watchdog at
all between the start of the kernel and the moment userspace opens
/dev/watchdog.

That is exactly the window an early boot hang falls into. On the Fairphone 3
a hang there leaves a phone that enumerates its USB gadget but never brings
up the link - no ssh, no adb, no fastboot - and only a physical button press
recovers it. CONFIG_WATCHDOG_OPEN_TIMEOUT is meant to cover precisely this
case and cannot, because the hardware is idle.

Add a qcom,start-at-probe property that starts the watchdog when the
bootloader did not, and set it on the FP3, whose watchdog register address
and 30 s bark come from Fairphone's downstream device tree. With it the
driver reports

  qcom_wdt b017000.watchdog: started at probe (bootloader left it disabled)

at 0.18 s, and an unattended device resets itself instead of waiting for
hands. The failure mode is safe: if userspace never takes over, each reset
decrements the A/B retry counter and the bootloader falls back to the other
slot.

The board side goes into its own sdm632-fairphone-fp3-debug.dtsi rather than
at the end of the board file, so that this commit can be replayed onto any
branch without a conflict. Every other category appends its nodes to the end
of sdm632-fairphone-fp3.dts; measured on 2026-07-30, the appended form
conflicted on wip/7.1.3/audio and on integration/7.1.3 while applying clean
on camera and charger. A separate file collides with nothing, and the one
include line sits among the other includes, which no category touches.

No ramoops node is added. It was tried at 0x8ee00000 and at 0xd0000000 and
nothing survives a reset on this device - not a pmsg marker across a clean
reboot, not a dmesg record after a real panic - so it would cost 2 MB and
imply a post-mortem capability that is not there.

Signed-off-by: Lajosházi, László Gergely <lajoshazilg@gmail.com>
Co-authored-by: Claude Opus 5 <noreply@anthropic.com>
---
 .../dts/qcom/sdm632-fairphone-fp3-debug.dtsi  | 54 +++++++++++++++++++
 .../boot/dts/qcom/sdm632-fairphone-fp3.dts    |  1 +
 drivers/watchdog/qcom-wdt.c                   | 18 +++++++
 3 files changed, 73 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3-debug.dtsi

diff --git a/arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3-debug.dtsi b/arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3-debug.dtsi
new file mode 100644
index 000000000000..bb68045e63eb
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3-debug.dtsi
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Fairphone 3 debug safety net -- NOT upstream material.
+ *
+ * This lives in its own .dtsi, included by one stable line near the top of the
+ * board file, for a purely mechanical reason: every other category appends its
+ * nodes to the END of sdm632-fairphone-fp3.dts, so a debug block that also
+ * appended there conflicted with whichever of them happened to be present.
+ * Measured on 2026-07-30: cherry-picking the old form conflicted on
+ * wip/7.1.3/audio and on integration/7.1.3, and applied clean on camera and
+ * charger. A separate file conflicts with nobody, and the include line sits
+ * among the other includes, far from anything the categories touch.
+ */
+
+/*
+ * Debug safety net (not upstream material).
+ *
+ * watchdog: the SoC watchdog the downstream tree drives at the same address.
+ * The block itself is Josh Cartwright's KPSS WDT (drivers/watchdog/qcom-wdt.c);
+ * mainline simply never described it on msm8953, so a stalled boot sits there
+ * forever and needs a physical power cycle.  The register address and the
+ * 30 s bark come from Fairphone's own downstream device tree.  With
+ * WATCHDOG_OPEN_TIMEOUT set, the core stops petting it when userspace has not
+ * taken over in time, and the SoC resets itself.
+ */
+/*
+ * No ramoops/pstore node here on purpose.  It was tried at 0x8ee00000 and again
+ * at 0xd0000000, and NOTHING survives a reset on this device: neither a pmsg
+ * marker across a clean reboot nor a dmesg record after a real panic
+ * (echo c > /proc/sysrq-trigger).  pstore registers and the console attaches --
+ * "printk: legacy console [ramoops-1] enabled" -- so the writes happen; the RAM
+ * is simply gone by the time the next kernel reads it, at either address, which
+ * points at the boot chain rather than at the placement.  Keeping the node would
+ * cost 2 MB and buy nothing.  Post-mortem for an early hang needs the UART on
+ * this hardware, not pstore.
+ */
+
+&soc {
+	watchdog@b017000 {
+		compatible = "qcom,kpss-wdt";
+		reg = <0x0b017000 0x1000>;
+		clocks = <&sleep_clk>;
+		interrupts = <GIC_SPI 3 IRQ_TYPE_EDGE_RISING>;
+		timeout-sec = <30>;
+		/*
+		 * The FP3 bootloader leaves the watchdog disabled, so without
+		 * this the kernel has no watchdog until systemd opens the
+		 * device -- an early boot hang then needs a physical button
+		 * press. Starting it at probe makes CONFIG_WATCHDOG_OPEN_TIMEOUT
+		 * cover the whole boot.
+		 */
+		qcom,start-at-probe;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3.dts b/arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3.dts
index 0721df42fe7c..0aa4a9e13e15 100644
--- a/arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3.dts
+++ b/arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3.dts
@@ -8,6 +8,7 @@
 #include "sdm632.dtsi"
 #include "pm8953.dtsi"
 #include "pmi632.dtsi"
+#include "sdm632-fairphone-fp3-debug.dtsi"
 
 / {
 	model = "Fairphone 3";
diff --git a/drivers/watchdog/qcom-wdt.c b/drivers/watchdog/qcom-wdt.c
index dfaac5995c84..2bf9f2b27a96 100644
--- a/drivers/watchdog/qcom-wdt.c
+++ b/drivers/watchdog/qcom-wdt.c
@@ -10,6 +10,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/watchdog.h>
 
 enum wdt_reg {
@@ -289,10 +290,27 @@ static int qcom_wdt_probe(struct platform_device *pdev)
 	 * will stop the WDT, set timeouts as bootloader
 	 * might use different ones and set running bit
 	 * to inform the WDT subsystem to ping the WDT
+	 *
+	 * The WDOG_HW_RUNNING handling above is Robert Marko's (commit
+	 * 8650d0f9e933, "watchdog: qcom_wdt: set WDOG_HW_RUNNING bit when
+	 * appropriate"), on Josh Cartwright's original KPSS WDT driver.
+	 *
+	 * Added here: if the watchdog is NOT already running, start it anyway
+	 * when the device tree asks for it. Boards whose bootloader leaves the
+	 * watchdog disabled otherwise have no watchdog at all between the start
+	 * of the kernel and the moment userspace opens /dev/watchdog -- which is
+	 * exactly the window an early boot hang falls into, and the one where an
+	 * unattended device most needs to reset itself. With the bit set, the
+	 * watchdog core pings the hardware for us and enforces
+	 * CONFIG_WATCHDOG_OPEN_TIMEOUT.
 	 */
 	if (qcom_wdt_is_running(&wdt->wdd)) {
 		qcom_wdt_start(&wdt->wdd);
 		set_bit(WDOG_HW_RUNNING, &wdt->wdd.status);
+	} else if (device_property_read_bool(dev, "qcom,start-at-probe")) {
+		qcom_wdt_start(&wdt->wdd);
+		set_bit(WDOG_HW_RUNNING, &wdt->wdd.status);
+		dev_info(dev, "started at probe (bootloader left it disabled)\n");
 	}
 
 	ret = devm_watchdog_register_device(dev, &wdt->wdd);
-- 
2.53.0

