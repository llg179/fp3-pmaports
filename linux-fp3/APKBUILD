# Maintainer: Lajosházi, László Gergely <lajoshazilg@gmail.com>
#
# Fairphone 3 mainline kernel: the latest msm8953-mainline release plus the
# WCD9335 SLIMbus audio, Sony IMX363 camera and PMI632 charger work.
#
# The sources are the integration/<base> branch of the fork, pinned by commit,
# so this package carries no patches of its own. To move to a new base, bump
# pkgver and _commit together - that is the single version edit (see the
# repo's docs/rolling-a-new-base.md).
_flavor="fp3"
_commit="4143d42854451ed0887e22362cae19f63942199f"
pkgname=linux-$_flavor
pkgver=7.1.3
pkgrel=14
pkgdesc="msm8953-mainline for the Fairphone 3: WCD9335 audio, IMX363 camera, PMI632 charger"
arch="aarch64"
_carch="arm64"
url="https://github.com/llg179/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="bash bison findutils flex openssl-dev perl postmarketos-installkernel python3"
source="
	$pkgname-$_commit.tar.gz::https://github.com/llg179/linux/archive/$_commit.tar.gz
	config-$_flavor.aarch64
"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
	make ARCH="$_carch" CC="${CC:-gcc}" olddefconfig

	# Everything this device needs that the inherited config does not enable.
	# CONFIG_DRM_PANEL_HIMAX_HX83112B is the panel: it was renamed from
	# CONFIG_DRM_PANEL_FAIRPHONE_FP3_HX83112B after 6.13, and with the stale
	# name the driver silently is not built - the display then never comes up
	# and the compositor loops on "Found 0 GPUs".
	for c in CONFIG_SLIMBUS CONFIG_SLIM_QCOM_NGD_CTRL CONFIG_REGMAP_SLIMBUS \
		 CONFIG_SND_SOC_WCD9335 CONFIG_SND_SOC_WCD_CLASSH CONFIG_QCOM_BAM_DMA \
		 CONFIG_SND_SOC_AW8898 CONFIG_VIDEO_IMX363 \
		 CONFIG_DRM_PANEL_HIMAX_HX83112B CONFIG_CHARGER_QCOM_SMB2; do
		./scripts/config --module "$c"
	done
	./scripts/config --enable MODULE_COMPRESS_NONE \
		--disable MODULE_COMPRESS_ZSTD --disable MODULE_COMPRESS_XZ \
		--disable MODULE_COMPRESS_GZIP
	make ARCH="$_carch" CC="${CC:-gcc}" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" INSTALL_PATH="$pkgdir"/boot INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source
	install -Dm644 "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	# Record which integration/<base> commit this was built from. pkgrel alone
	# cannot tell two _commits apart - uname -v only carries pkgrel - so
	# without this stamp there is no way to ask a running device which kernel
	# source it came from. tests/fp3-selftest checks it.
	echo "$_commit" >"$pkgdir/usr/share/kernel/$_flavor/fp3-commit"
}
sha512sums="
3dd4acd4fa0ea90632e581536905dff36db697ac6501cf6e411b74e2b7b53939f0e98f94adcc3c7475a83a5d0ceb517ef9a0a098664faf21fa2bf0e3b8081fc7  linux-fp3-4143d42854451ed0887e22362cae19f63942199f.tar.gz
ccc35b2a5327a893d3c7caee9ae744a56e53fcd7e145d771b8704b87585e6f8e0ca6973a1138b3e58542ed82c3fe71cf851deabcd78ce1fea7eabaa1b8008870  config-fp3.aarch64
"
